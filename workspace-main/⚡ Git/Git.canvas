		},
		{
			"id":"d87328a9028ec46f",
			"styleAttributes":{},
			"text":"git add .",
			"type":"text",
			"x":2852,
			"y":2530,
			"width":250,
			"height":60
		},
		{
			"id":"0793841b4293e9b7",
			"styleAttributes":{},
