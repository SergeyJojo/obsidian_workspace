			"type":"text",
			"x":2852,
			"y":2431,
			"width":250,
			"height":60
		},
		{
			"id":"5bed22c3d74614d3",
			"styleAttributes":{},
			"text":"Git add",
			"type":"text",
			"x":2159,
			"y":2429,
			"width":250,
			"height":60
		},
		{
			"id":"a119ef07fc9017f2",
			"styleAttributes":{},
			"text":"Добавляет изменения из рабочего каталога в индекс (staging area)",
			"type":"text",
			"x":2500,
			"y":2409,
			"width":250,
			"height":100
		},
		{
			"id":"077dc03ab9510b96",
			"styleAttributes":{},
			"text":"Как работает",
			"type":"text",
			"x":2500,
			"y":3004,
			"width":250,
			"height":60
		},
		{
			"id":"085efc36028ac182",
			"styleAttributes":{},
			"text":"Создает подкаталог \".git\" в текущем каталоге",
			"type":"text",
			"x":4314,
			"y":1265,
			"width":250,
			"height":60
		},
		{
			"id":"70bcbc778ce54c93",
			"styleAttributes":{},
			"text":"Создает базовые файлы конфигурации и шаблоны для коммитов",
			"type":"text",
			"x":4314,
			"y":1384,
			"width":250,
			"height":105
		},
		{
			"id":"d89ff97e33c10fa0",
			"styleAttributes":{},
			"text":"Существует \"bare\" репозиторий",
			"type":"text",
			"x":4283,
			"y":2122,
			"width":250,
			"height":60
		},
		{
			"id":"3f3b2e696ae7921a",
			"styleAttributes":{},
			"text":"git init --bare",
			"type":"text",
			"x":4894,
			"y":2122,
			"width":250,
			"height":60
		},
		{
			"id":"7869f9a07e105b7f",
			"styleAttributes":{},
			"text":"path - путь до каталога",
			"type":"text",
			"x":4588,
			"y":1886,
			"width":250,
			"height":60
		},
		{
			"id":"1b13649e078ea5d4",
			"styleAttributes":{},
			"text":"Используется для хранения истории изменений и не содержит рабочего каталога",
			"type":"text",
			"x":4588,
			"y":2092,
			"width":250,
			"height":120
		},
		{
			"id":"5b3e555cc2eff020",
			"styleAttributes":{},
			"text":"--bare - является аргументом, создает \"bare\" репозиторий",
			"type":"text",
			"x":4894,
			"y":2226,
			"width":250,
			"height":98
		},
		{
			"id":"2e73d2ec742059af",
			"styleAttributes":{},
			"text":"Устанавливает HEAD (указатель на текущую ветку) на начальный коммит ",
			"type":"text",
			"x":4314,
			"y":1504,
			"width":250,
			"height":124
		},
		{
			"id":"36a8a9cfed3157d1",
			"styleAttributes":{},
			"text":"Содержит необходимые файлы для работы Git, включая историю изменений, индексы и настройки",
			"type":"text",
			"x":4623,
			"y":1220,
			"width":250,
			"height":150
		},
		{
			"id":"a2f959faa1e07659",
			"styleAttributes":{},
			"text":"Скопировать ключ и вставить по ссылке [клик](https://github.com/settings/keys)",
			"type":"text",
			"x":4343,
			"y":195,
			"width":250,
			"height":60
		},
		{
			"id":"58cb67b4e503f179",
			"styleAttributes":{},
			"text":"С помощью блокнота открыть id_rsa.pub",
			"type":"text",
			"x":4040,
			"y":195,
			"width":250,
			"height":60
		},
		{
			"id":"aaae3def9f0bb22a",
			"styleAttributes":{},
			"text":"Открыть Git Bash",
			"type":"text",
			"x":4040,
			"y":302,
			"width":250,
			"height":60
		},
		{
			"id":"6cd746585211bb74",
			"styleAttributes":{},
			"text":"Чтобы создать репозиторий в родительском каталоге, то нужно указать путь к каталогу",
			"type":"text",
			"x":3988,
			"y":1844,
			"width":250,
			"height":144
		},
		{
			"id":"1fad2f001af7ee8f",
			"styleAttributes":{},
			"text":"Инициализирует новый пустой репозиторий Git в указанном каталоге",
			"type":"text",
			"x":3683,
			"y":1244,
			"width":250,
			"height":101
		},
		{
			"id":"aeb101cfec4437f7",
			"styleAttributes":{},
			"text":"Суть git init",
			"type":"text",
			"x":4003,
			"y":1265,
			"width":250,
			"height":60
		},
		{
			"id":"785c58d64004eb7a",
			"styleAttributes":{},
			"text":"git init",
			"type":"text",
			"x":3380,
			"y":1265,
			"width":250,
			"height":60
		},
		{
			"id":"edd66ac0ee920ced",
			"styleAttributes":{},
			"text":"Ввести \"ssh -T git@github.com\"",
			"type":"text",
			"x":4343,
			"y":302,
			"width":314,
			"height":60
		},
		{
			"id":"8e55c711606eeb06",
			"styleAttributes":{},
			"text":"Создание SSH-ключа",
			"type":"text",
			"x":3714,
			"y":86,
			"width":250,
			"height":60
		},
		{
			"id":"8caddb8d888b21a5",
			"styleAttributes":{},
			"text":"```ssh\nssh-keygen -t rsa -b 4096 -C \"email\"\n```",
			"type":"text",
			"x":4040,
			"y":86,
			"width":380,
			"height":60
		},
		{
			"id":"ea3111d95fabd28f",
			"styleAttributes":{},
			"text":"В папке C:\\Users\\YOU\\.ssh\\",
			"type":"text",
			"x":3714,
			"y":195,
			"width":250,
			"height":60
		},
		{
			"id":"55f311286b2bdd7b",
			"styleAttributes":{},
			"text":"Проверить соединение",
			"type":"text",
			"x":3714,
			"y":302,
			"width":250,
			"height":60
		},
		{
			"id":"ac063941bf00fd5e",
			"styleAttributes":{},
			"text":"git init %path%",
			"type":"text",
			"x":4290,
			"y":1886,
			"width":250,
			"height":60
		},
		{
			"id":"00977f421f7c5a80",
			"styleAttributes":{},
			"text":"Выполняет только один раз для каждого проекта",
			"type":"text",
			"x":3988,
			"y":1744,
			"width":250,
			"height":60
		},
		{
			"id":"1004f7683825f665",
			"styleAttributes":{},
			"text":"Проверка настроек",
			"type":"text",
			"x":3714,
			"y":-38,
			"width":250,
			"height":60
		},
		{
			"id":"870e28044bca2c29",
			"styleAttributes":{},
			"text":"```git\ngit config --global user.name \"Имя\"\ngit config --global user.email \"email\"\n```",
			"type":"text",
			"x":4040,
			"y":-180,
			"width":406,
			"height":104
		},
		{
			"id":"dfcf608a19187b4b",
			"styleAttributes":{},
			"text":"```git\ngit config --list\n```",
			"type":"text",
