			"width":250,
			"height":60
		},
		{
			"id":"ce49fb00c24749bd",
			"styleAttributes":{},
			"text":"Настройка Git",
			"type":"text",
			"x":3380,
			"y":-158,
			"width":250,
			"height":60
		},
		{
			"id":"efe26c0ca79e941f",
			"styleAttributes":{},
			"text":"Область, где временно хранятся изменения, подготовленные для коммита",
			"type":"text",
			"x":2530,
			"y":-34,
			"width":250,
			"height":120
		},
		{
			"id":"9e7bd2744901a511",
			"styleAttributes":{},
			"text":"Индекс (staging area)",
			"type":"text",
			"x":2203,
			"y":-4,
			"width":250,
			"height":60
		},
		{
			"id":"4fc7f8a07a5726ea",
			"styleAttributes":{},
			"text":"Сообщение коммита должно быть кратким и информативным",
			"type":"text",
			"x":2655,
			"y":1604,
			"width":250,
			"height":86
		},
		{
			"id":"61f8a8bcbdaffaa9",
			"styleAttributes":{},
			"text":"URL - копируется со страницы созданного репозитория на GitHub",
			"type":"text",
			"x":2655,
			"y":1767,
			"width":250,
			"height":101
		},
		{
			"id":"d3e918305cdb5742",
			"styleAttributes":{},
			"text":"Инициализация локального репозитория Git",
			"type":"text",
			"x":1996,
			"y":1220,
			"width":250,
			"height":98
		},
		{
			"id":"53224cdeeccbec6f",
			"styleAttributes":{},
			"text":"Добавление файлов проекта в индекс (staging area)",
			"type":"text",
			"x":1996,
			"y":1357,
			"width":250,
			"height":101
		},
		{
			"id":"30d2a723100d9d40",
			"styleAttributes":{},
			"text":"git add .",
			"type":"text",
			"x":2330,
			"y":1378,
			"width":250,
			"height":60
		},
		{
			"id":"a5c116367b752a3e",
			"styleAttributes":{},
			"text":"git add %filename%",
			"type":"text",
			"x":2655,
			"y":1378,
			"width":250,
			"height":60
		},
		{
			"id":"8c73d5765c467043",
			"styleAttributes":{},
			"text":"База данных, содержащая историю изменений проекта",
			"type":"text",
			"x":2530,
			"y":119,
			"width":250,
			"height":97
		},
		{
			"id":"b9b7c5748f1983a6",
			"styleAttributes":{},
			"text":"Репозиторий Git",
			"type":"text",
			"x":2203,
			"y":138,
			"width":250,
			"height":60
		},
		{
			"id":"2be1b0acea85b35a",
			"styleAttributes":{},
			"text":"git init",
			"type":"text",
			"x":2330,
			"y":1239,
			"width":250,
			"height":60
		},
		{
			"id":"e3fb88bfffb6d157",
			"styleAttributes":{},
			"text":"Позволяет в дальнейшем использовать git push без дополнительных аргументов",
			"type":"text",
			"x":2980,
			"y":1886,
			"width":250,
			"height":142
		},
		{
			"id":"f9a4d5258b1f85d7",
			"styleAttributes":{},
			"text":"Добавляет конкретный файл",
			"type":"text",
			"x":2655,
			"y":1475,
			"width":250,
			"height":60
		},
		{
			"id":"ab91dd27a21b37cc",
			"styleAttributes":{},
			"text":"Добавляет все файлы",
			"type":"text",
			"x":2330,
			"y":1475,
			"width":250,
			"height":60
		},
		{
			"id":"244c663821104b16",
			"styleAttributes":{},
			"text":"Флаг -u устанавливает отслеживание ветки",
			"type":"text",
			"x":2655,
			"y":1917,
			"width":250,
			"height":60
		},
		{
			"id":"076f4e2a43f491f6",
			"styleAttributes":{},
			"text":"git commit -m \"Initial commit\"",
			"type":"text",
			"x":2330,
			"y":1610,
			"width":250,
			"height":75
		},
		{
			"id":"8c3ae81d260a471f",
			"styleAttributes":{},
			"text":"git remote add origin %URL%",
			"type":"text",
			"x":2330,
			"y":1788,
			"width":250,
			"height":60
		},
		{
			"id":"55964bca592f03ca",
			"styleAttributes":{},
			"text":"git push -u origin main",
			"type":"text",
			"x":2330,
			"y":1917,
			"width":250,
			"height":60
		},
		{
			"id":"16840f6e57ef5f2c",
			"styleAttributes":{},
			"text":"Связать локальный репозиторий с удаленным на GitHub",
			"type":"text",
			"x":1996,
			"y":1770,
			"width":250,
			"height":95
		},
		{
			"id":"770169ff62bdb905",
			"styleAttributes":{},
			"text":"Отправка проекта на GitHub",
			"type":"text",
			"x":1996,
			"y":1917,
			"width":250,
			"height":60
		},
		{
			"id":"a1e43270038cbfc9",
			"styleAttributes":{},
			"text":"Создание первого коммита (сохранение изменений)",
			"type":"text",
			"x":1996,
			"y":1597,
			"width":250,
			"height":100
		},
		{
			"id":"4c908e361139729f",
			"styleAttributes":{},
			"text":"По умолчанию функция создает \"не bare\" репозиторий, предназначенный для работы с файлами проекта",
			"type":"text",
			"x":3983,
			"y":2059,
			"width":250,
			"height":185
		},
		{
			"id":"a810ab7d2f7fff2c",
			"styleAttributes":{},
			"text":"Важные моменты",
			"type":"text",
			"x":3683,
			"y":1744,
			"width":250,
			"height":60
		},
		{
			"id":"346fc6485993f89b",
			"styleAttributes":{},
			"text":"Место, где находятся файлы проекта, с которыми работает пользователь",
			"type":"text",
			"x":2530,
			"y":-180,
			"width":250,
			"height":123
		},
		{
			"file":"Cache/Pasted image 20250208004737.png",
			"id":"e52ec17a26042519",
			"styleAttributes":{},
			"type":"file",
			"x":2830,
			"y":-82,
			"width":400,
			"height":225
		},
		{
			"id":"6cc29c9eeca8a1f8",
			"styleAttributes":{},
			"text":"Рабочий каталог (working directory)",
			"type":"text",
			"x":2203,
			"y":-149,
			"width":250,
			"height":60
		},
		{
			"id":"54a3ac8430145335",
			"styleAttributes":{},
			"text":"Архитектура Git",
			"type":"text",
			"x":1870,
			"y":-149,
			"width":250,
			"height":60
		},
		{
			"id":"4bdf947a4c05dbdb",
			"styleAttributes":{},
			"text":"Каждый разработчик работает над своей веткой, затем объединяет изменения в основную ветку",
			"type":"text",
			"x":1440,
			"y":-180,
			"width":256,
			"height":147
		},
		{
			"id":"9e62b1dce68978eb",
			"styleAttributes":{},
			"text":"Поддерживает Pull Request (PR), который позволяет обсуждать и проверять изменения перед объединением в основную ветку",
			"type":"text",
			"x":1440,
			"y":298,
			"width":250,
			"height":182
		},
		{
			"id":"da821d65447f16db",
			"styleAttributes":{},
			"text":"Позволяет контролировать, кто и какие изменения может вносить в проект",
			"type":"text",
			"x":1443,
			"y":100,
			"width":250,
			"height":115
		},
		{
			"id":"5483864033e2a1e9",
			"styleAttributes":{},
			"text":"Пример вывода",
			"type":"text",
			"x":76,
			"y":3217,
			"width":250,
			"height":60
		},
		{
			"id":"b58213a4451cb7a2",
			"styleAttributes":{},
			"text":"Статусы",
			"type":"text",
			"x":376,
			"y":2411,
			"width":250,
			"height":60
		},
		{
			"id":"7bef057a509cbe5c",
			"styleAttributes":{},
			"text":"Сообщает, какие файлы были изменены, какие добавлены в индекс, какие остаются не отслеживаемыми",
			"type":"text",
			"x":76,
			"y":2364,
			"width":250,
			"height":154
		},
		{
			"id":"37e085bd350f9a22",
			"styleAttributes":{},
			"text":"```git\nOn branch main \nYour branch is up to date with 'origin/main'. \nChanges not staged for commit: \n\t(use \"git add <file>...\" to update what will be committed) \n\t(use \"git restore <file>...\" to discard changes in working directory)\n\t\tmodified: myfile.txt \n\t\tmodified: anotherfile.txt \n\t\t\nUntracked files:\n\t(use \"git add <file>...\" to include in what will be committed)\n\t\tnewfile.txt \n\t\nno changes added to commit (use \"git add\" and/or \"git commit -a\")\n```",
			"type":"text",
			"x":409,
			"y":3072,
			"width":647,
			"height":349
		},
		{
			"id":"df89af608dfec298",
			"styleAttributes":{},
			"text":"Используется в терминале, находясь в корневой папке репозитория",
			"type":"text",
			"x":-244,
			"y":3185,
			"width":250,
			"height":123
		},
		{
			"id":"d85cd792aa456ffa",
			"styleAttributes":{},
			"text":"Показывает текущее состояние файлов в репозитории",
			"type":"text",
			"x":-244,
			"y":2394,
			"width":250,
			"height":94
		},
		{
			"id":"a0ba26ad6b36c886",
			"styleAttributes":{},
			"text":"Видимость",
			"type":"text",
			"x":367,
			"y":1558,
			"width":250,
			"height":60
		},
		{
			"id":"b89b9d78f8a66eb5",
			"styleAttributes":{},
			"text":"Add a README file",
			"type":"text",
			"x":367,
			"y":1871,
			"width":250,
			"height":60
		},
		{
			"id":"a1d0299661d721a7",
			"styleAttributes":{},
			"text":"Private",
			"type":"text",
			"x":665,
			"y":1688,
			"width":250,
			"height":60
		},
		{
			"id":"e2cc02321bab246c",
			"styleAttributes":{},
			"text":"Добавляет файл README. Это файл с описанием проекта, который отображается на главной странице репозитория",
			"type":"text",
			"x":665,
			"y":1823,
			"width":250,
			"height":155
		},
		{
			"id":"ff9704dcc0f50b06",
			"styleAttributes":{},
			"text":"Git status",
			"type":"text",
			"x":-543,
			"y":2411,
			"width":250,
			"height":60
		},
		{
			"id":"8feb51a41c2cbda4",
			"styleAttributes":{},
			"text":"В этом файле перечисляются файлы и папки, которые Git должен игнорировать ",
			"type":"text",
			"x":665,
			"y":2031,
			"width":250,
			"height":123
		},
		{
			"id":"196166131e93e3f8",
			"styleAttributes":{},
			"text":"Создание репозитория на Github",
			"type":"text",
			"x":-543,
			"y":1239,
			"width":250,
			"height":60
		},
		{
			"id":"4bfe04ab84764597",
			"styleAttributes":{},
			"text":"Add .gitignore",
			"type":"text",
			"x":366,
			"y":2063,
			"width":250,
			"height":60
		},
		{
			"id":"cb0923fff635902e",
			"styleAttributes":{},
			"text":"Используется для",
			"type":"text",
			"x":568,
			"y":127,
			"width":250,
			"height":60
		},
		{
			"id":"b755a245b9d98434",
			"styleAttributes":{},
			"text":"На главной [странице](https://github.com/dashboard) нажать на плюсик",
			"type":"text",
			"x":-242,
			"y":1239,
			"width":250,
			"height":60
		},
		{
			"id":"828425867d5b35b9",
			"styleAttributes":{},
			"text":"Выбрать пункт \"New Repository\"",
			"type":"text",
			"x":58,
			"y":1239,
			"width":250,
			"height":60
		},
		{
			"id":"a0bef06ddcf51613",
			"styleAttributes":{},
			"text":"Используется для управления задачами, отслеживания багов, организации совместной работы через PR, а также для автоматизации процессов с помощью GitHub Actions",
			"type":"text",
			"x":-216,
			"y":940,
			"width":349,
			"height":162
		},
		{
			"id":"a85c1bc188fba4df",
			"styleAttributes":{},
			"text":"Платформа для хостинга и управления Git-репозиториями",
			"type":"text",
			"x":-167,
			"y":780,
			"width":250,
			"height":92
		},
		{
			"id":"a66a001b3318835a",
			"styleAttributes":{},
			"text":"Совместной работы над кодом",
			"type":"text",
			"x":944,
			"y":-136,
			"width":250,
			"height":60
		},
		{
			"id":"a94ea38ad244b5cc",
			"styleAttributes":{},
			"text":"Ограничения доступа",
			"type":"text",
			"x":944,
			"y":126,
			"width":250,
			"height":60
		},
		{
			"id":"13c505b841262f68",
			"styleAttributes":{},
			"text":"Объединения изменений",
			"type":"text",
			"x":944,
			"y":359,
			"width":250,
			"height":60
		},
		{
			"id":"6cae192204fa41aa",
			"styleAttributes":{},
			"text":"Git",
			"type":"text",
			"x":-167,
			"y":-40,
			"width":250,
			"height":60
		},
		{
			"id":"3f630d89f9bb658b",
			"styleAttributes":{},
			"text":"Создан для удобной работы с большими проектами",
			"type":"text",
			"x":156,
			"y":337,
			"width":250,
			"height":103
		},
		{
			"id":"00109689228f7d5a",
			"styleAttributes":{},
			"text":"GitHub - [клик](https://github.com/)",
			"type":"text",
			"x":-167,
			"y":642,
			"width":250,
			"height":60
		},
		{
			"id":"c8c573ac7f3732c1",
			"styleAttributes":{},
			"text":"Git - [клик](https://git-scm.com/)",
			"type":"text",
			"x":157,
			"y":156,
			"width":250,
			"height":60
		},
		{
			"id":"13977d60ef7b32dc",
			"styleAttributes":{},
			"text":"VSC (Version Control System)",
			"type":"text",
			"x":-485,
			"y":173,
			"width":250,
			"height":60
		},
		{
			"id":"b1b42ea210c09c90",
			"styleAttributes":{},
			"text":"Полезно, когда нужно исключить файл из Git'a, но сохранить его локально",
			"type":"text",
			"x":3314,
			"y":7602,
			"width":250,
			"height":123
		},
		{
			"id":"2233d303d003e457",
			"styleAttributes":{},
			"text":"Используется, если файл был изменен и нужно отменить эти изменения и удалить файл",
			"type":"text",
			"x":3314,
			"y":7740,
			"width":250,
			"height":135
		},
		{
			"id":"5b990226cccb2d32",
			"styleAttributes":{},
			"text":"Удаляет указанный файл только из индекса, оставляя его в рабочем каталоге",
			"type":"text",
			"x":2993,
			"y":7602,
			"width":250,
			"height":123
		},
		{
			"id":"ccefd3c4c9f3f1ac",
			"styleAttributes":{},
			"text":"Принудительное удаление файла",
			"type":"text",
			"x":2993,
			"y":7778,
			"width":250,
			"height":60
		},
		{
			"id":"3ccd6133d207afbe",
			"styleAttributes":{},
			"text":"git revert - когда нужно отменить изменения в коммите, который уже был отправлен в публичный репозиторий",
			"type":"text",
			"x":-247,
			"y":8060,
			"width":250,
			"height":158
		},
		{
			"file":"Cache/Pasted image 20250210125528.png",
			"id":"4f8106df2a04accd",
			"styleAttributes":{},
			"type":"file",
			"x":110,
			"y":8088,
			"width":375,
			"height":400
		},
		{
			"id":"750e174fb5567c27",
			"styleAttributes":{},
			"text":"Когда revert, а когда reset?",
			"type":"text",
			"x":-543,
			"y":8258,
			"width":250,
			"height":60
		},
		{
			"id":"cf012d38ababe0b0",
			"styleAttributes":{},
			"text":"Позволяет увидеть какие файлы будут удалены, не удаляя их на самом деле",
			"type":"text",
			"x":2993,
			"y":7960,
			"width":250,
			"height":102
		},
		{
			"id":"311575998256ac23",
			"styleAttributes":{},
			"text":"Рекурсивное удаление каталога и всего его содержимого",
			"type":"text",
			"x":2993,
			"y":7860,
			"width":250,
			"height":95
		},
		{
			"id":"758ffca1ee9f1ac5",
			"styleAttributes":{},
			"text":"Инструмент для отслеживания изменения в файлах проекта, позволяет управлять разными версиями кода, работать совместно с другими разработчиками и восстанавливать предыдущие состояния файлов при необходимости",
			"type":"text",
			"x":-543,
			"y":300,
			"width":367,
			"height":182
		},
		{
			"id":"ec9def057b40c64b",
			"styleAttributes":{},
			"text":"--mixed",
			"type":"text",
			"x":688,
			"y":7679,
			"width":250,
			"height":60
		},
		{
			"id":"972bc79104a55379",
			"styleAttributes":{},
			"text":"\\<commit-ish> - коммит, на который нужно переместить указатель",
			"type":"text",
			"x":864,
			"y":8098,
			"width":250,
			"height":94
		},
		{
			"id":"141e708c0ecf6f6d",
			"styleAttributes":{},
			"text":"Может быть хэш, имя ветки или относительное указание",
			"type":"text",
			"x":864,
			"y":8228,
			"width":250,
			"height":90
		},
		{
			"id":"287809e77dc08520",
			"styleAttributes":{},
			"text":"--hard",
			"type":"text",
			"x":688,
			"y":7817,
			"width":250,
			"height":60
		},
		{
			"id":"c87b05e5612a1a2b",
			"styleAttributes":{},
			"text":"git reset - когда нужно отменить изменения в коммитах, которые только в локальном репозитории и не были ни с кем общими",
			"type":"text",
			"x":-247,
			"y":8380,
			"width":250,
			"height":180
		},
		{
			"id":"30d05aab22de485b",
			"styleAttributes":{},
			"text":"Удаление происходит из рабочего каталога, так и из индекса, готовит это изменение для следующего коммита",
			"type":"text",
			"x":1980,
			"y":7627,
			"width":250,
			"height":155
		},
		{
			"id":"40037b2c1d45cd98",
			"styleAttributes":{},
			"text":"```git\ngit rm -f <file>\ngit rm --force <file>\n```",
			"type":"text",
			"x":2620,
			"y":7760,
			"width":265,
			"height":95
		},
		{
			"id":"8ab410157e505376",
			"styleAttributes":{},
			"text":"```git\ngit rm -r <directory>\ngit rm --recursive <directory>\n```",
			"type":"text",
			"x":2620,
			"y":7862,
			"width":346,
			"height":91
		},
		{
			"id":"7f5756f76186999f",
			"styleAttributes":{},
			"text":"```git\ngit rm -n <file>\n```",
			"type":"text",
			"x":2620,
			"y":7981,
			"width":250,
			"height":60
		},
		{
			"id":"601d48b593077ff1",
			"styleAttributes":{},
			"text":"```git\ngit rm --cached <file>\n```",
			"type":"text",
			"x":2620,
			"y":7633,
			"width":265,
			"height":60
		},
		{
			"id":"4b5ad88f1a30131a",
			"styleAttributes":{},
			"text":"Синтаксис",
			"type":"text",
			"x":360,
			"y":8000,
			"width":250,
			"height":60
		},
		{
			"id":"3a59c2063eedc22b",
			"styleAttributes":{},
			"text":"```git\ngit reset [--soft | --mixed | --hard] <commit-ish>\n```",
			"type":"text",
			"x":727,
			"y":8000,
			"width":523,
			"height":60
		},
		{
			"id":"3b08cdec7b207616",
			"styleAttributes":{},
			"text":"Режимы работы",
			"type":"text",
			"x":360,
			"y":7513,
			"width":250,
			"height":60
		},
		{
			"id":"12c14bdc24106632",
			"styleAttributes":{},
			"text":"Не нужно использовать на ветках в удаленном репозитории, которые уже были опубликованы",
			"type":"text",
			"x":49,
			"y":7642,
			"width":250,
			"height":123
		},
		{
			"id":"5cf5b2860a9b8470",
			"styleAttributes":{},
			"text":"В отличии от revert, reset переписывает историю",
			"type":"text",
			"x":49,
			"y":7513,
			"width":250,
			"height":60
		},
		{
			"id":"8c27b5aff0c54e33",
			"styleAttributes":{},
			"text":"--soft",
			"type":"text",
			"x":688,
			"y":7513,
			"width":250,
			"height":60
		},
		{
			"id":"153c15ff41c3da82",
			"styleAttributes":{},
			"text":"Добавление изменений в последний коммит",
			"type":"text",
			"x":4907,
			"y":7620,
			"width":250,
			"height":60
		},
		{
			"id":"774fb23adb44d79a",
			"styleAttributes":{},
			"text":"Изменение сообщения коммита",
			"type":"text",
			"x":4907,
			"y":7489,
			"width":250,
			"height":60
		},
		{
			"id":"2ccc63fde6827e61",
			"styleAttributes":{},
			"text":"Не рекомендуется использовать в публичном репозитории для изменения коммитов",
			"type":"text",
			"x":4720,
			"y":8021,
			"width":250,
			"height":118
		},
		{
			"id":"97475c652c86bfec",
			"styleAttributes":{},
			"text":"Для изменения более ранних коммитов, нужно использовать другие инструменты. Amend изменяет только последний коммит",
			"type":"text",
			"x":4720,
			"y":8160,
			"width":250,
			"height":182
		},
		{
			"id":"bd660921b49eed4e",
			"styleAttributes":{},
			"text":"```git\ngit commit --amend --author=\"New author <email>\"\n```",
			"type":"text",
			"x":5226,
			"y":7738,
			"width":497,
			"height":60
		},
		{
			"id":"7070ff01a76f802a",
			"styleAttributes":{},
			"text":"Изменение автора последнего коммита",
			"type":"text",
			"x":5786,
			"y":7738,
			"width":250,
			"height":60
		},
		{
			"id":"9092acee6e37e6c7",
			"styleAttributes":{},
			"text":"Кейсы использования",
			"type":"text",
			"x":5459,
			"y":7918,
			"width":250,
			"height":60
		},
		{
			"id":"1dc4765d01e0b6b5",
			"styleAttributes":{},
			"text":"Для исправления опечаток в сообщении последнего коммита",
			"type":"text",
			"x":5786,
			"y":7904,
			"width":250,
			"height":90
		},
		{
			"file":"Cache/Pasted image 20250210134932.png",
			"id":"5c1bf989d5e3d050",
			"styleAttributes":{},
			"type":"file",
			"x":7200,
			"y":7839,
			"width":400,
			"height":223
		},
		{
			"id":"68e030606ec1c38b",
			"styleAttributes":{},
			"text":"reset vs revert vs checkout",
			"type":"text",
			"x":6740,
			"y":7921,
			"width":250,
			"height":60
		},
		{
			"id":"0c1915dc9112f5af",
			"styleAttributes":{},
			"text":"Изменение автора коммита",
			"type":"text",
			"x":4903,
			"y":7738,
			"width":250,
			"height":60
		},
		{
			"id":"ba2cdd835dbeb22c",
			"styleAttributes":{},
			"text":"Использование в удаленном репозитории может привести к проблемам. Лучше использовать revert",
			"type":"text",
			"x":5028,
			"y":7876,
			"width":250,
			"height":145
		},
		{
			"id":"c17eeb5da605c6ba",
			"styleAttributes":{},
			"text":"git commit --amend переписывает историю, значит хэш коммита будет другим",
			"type":"text",
			"x":4720,
			"y":7887,
			"width":250,
			"height":122
		},
		{
			"id":"bd403b0d3abce5a0",
			"styleAttributes":{},
			"text":"Изменение сообщение последнего коммита",
			"type":"text",
			"x":5786,
			"y":7489,
			"width":250,
			"height":60
		},
		{
			"id":"d430ee732ff7e3c8",
			"styleAttributes":{},
			"text":"```git\ngit add <changed_files>\ngit commit --amend\n```",
			"type":"text",
			"x":5226,
			"y":7601,
			"width":274,
			"height":98
		},
		{
			"id":"280b6a1394d54af4",
			"styleAttributes":{},
			"text":"Команда добавит изменения из индекса в последний коммит",
			"type":"text",
			"x":6101,
			"y":7601,
			"width":250,
			"height":99
		},
		{
			"id":"98ebf08a631058a0",
			"styleAttributes":{},
			"text":"```git\ngit commit --amend -m \"New message\"\n```",
			"type":"text",
			"x":5226,
			"y":7489,
			"width":374,
			"height":60
		},
		{
			"id":"8f82e4fc3b1cfb2b",
			"styleAttributes":{},
			"text":"Для добавления забытых изменений в последний коммит (до того, как он был опубликован)",
			"type":"text",
			"x":5786,
			"y":8000,
			"width":250,
			"height":133
		},
		{
			"id":"ce4e7055e0fd418e",
			"styleAttributes":{},
			"text":"Для небольших исправлений в последнем коммите, которые еще не были опубликованы",
			"type":"text",
			"x":5786,
			"y":8142,
			"width":250,
			"height":118
		},
		{
			"id":"7a60d9e6a6ac2a4e",
			"styleAttributes":{},
			"text":"Сначала изменения вносятся в индекс через git add, затем выполняется amend",
			"type":"text",
			"x":5786,
			"y":7589,
			"width":250,
			"height":123
		},
		{
			"id":"b8b65de1c6cd9b7a",
			"styleAttributes":{},
			"text":"Если не добавлять новые файлы в индекс, то откроется текстовый редактор для редактирования сообщений",
			"type":"text",
			"x":6421,
			"y":7562,
			"width":250,
			"height":178
		},
		{
			"id":"f8a618944b049259",
			"styleAttributes":{},
			"text":"Если опустить \"-m\", то откроется текстовый редактор для редактирования",
			"type":"text",
			"x":6101,
			"y":7455,
			"width":250,
			"height":128
		},
		{
			"id":"773884124a26cead",
			"styleAttributes":{},
			"text":"Полезно, когда нужно исправить опечатку в сообщении коммита, добавить забытые изменения или полностью переписать последний коммит",
			"type":"text",
			"x":4220,
			"y":7622,
			"width":250,
			"height":207
		},
		{
			"id":"ee6420210076f03a",
			"styleAttributes":{},
			"text":"git commit --amend",
			"type":"text",
			"x":3920,
			"y":7489,
			"width":250,
			"height":60
		},
		{
			"id":"94e6a5cbde857d0b",
			"styleAttributes":{},
			"text":"Используется для изменения последнего коммита",
			"type":"text",
			"x":4220,
			"y":7474,
			"width":250,
			"height":90
		},
		{
			"id":"2faebd06996750aa",
			"styleAttributes":{},
			"text":"-p или --patch",
			"type":"text",
			"x":4540,
			"y":6996,
			"width":250,
			"height":60
		},
		{
			"id":"17af43ba2fabab5e",
			"styleAttributes":{},
			"text":"--n или --no-commit",
			"type":"text",
			"x":4540,
			"y":6813,
			"width":250,
			"height":60
		},
		{
			"id":"822049bf43919ff7",
			"styleAttributes":{},
			"text":"Аргументы/опции",
			"type":"text",
			"x":4242,
			"y":6812,
			"width":250,
			"height":60
		},
		{
			"id":"97ee60d1b46de415",
			"styleAttributes":{},
			"text":"Позволяет отменить несколько коммитов, указав его диапазон",
			"type":"text",
			"x":4907,
			"y":7127,
			"width":250,
			"height":111
		},
		{
			"id":"0a3a21b6a3406138",
			"styleAttributes":{},
			"text":"Позволяет интерактивно выбирать, какие изменения из указанного коммита нужно отменить",
			"type":"text",
			"x":4907,
			"y":6965,
			"width":250,
			"height":122
		},
		{
			"id":"ffb86f9e0a0d413f",
			"styleAttributes":{},
			"text":"Важные моменты",
			"type":"text",
			"x":4407,
			"y":7918,
			"width":250,
			"height":60
		},
		{
			"id":"2b3f273a2606dfd9",
			"styleAttributes":{},
			"text":"Использование",
			"type":"text",
			"x":4562,
			"y":7489,
			"width":250,
			"height":60
		},
		{
			"id":"35908e3f004bd3ea",
			"styleAttributes":{},
			"text":"Используется для отмены изменений в репозитории путем создания нового коммита",
			"type":"text",
			"x":4540,
			"y":5824,
			"width":250,
			"height":125
		},
		{
			"id":"c7704198c208742b",
			"styleAttributes":{},
			"text":"Полезно, если нужно внести дополнительные изменения в отмененные изменения перед коммитом",
			"type":"text",
			"x":5209,
			"y":6763,
			"width":250,
			"height":160
		},
		{
			"id":"2ca1499cda19e81e",
			"styleAttributes":{},
			"text":"Нужно добавить файлы в индекс и сделать коммит",
			"type":"text",
			"x":5518,
			"y":6813,
			"width":250,
			"height":60
		},
		{
			"id":"c78d2d258d22cbd7",
			"styleAttributes":{},
			"text":"Добавляется коммит от git revert, в котором показывается, что изменения были отменены",
			"type":"text",
			"x":5518,
			"y":6618,
			"width":250,
			"height":145
		},
		{
			"id":"c7a6d1a7f3617071",
			"styleAttributes":{},
			"text":"Исходный коммит сохраняется в истории",
			"type":"text",
			"x":5209,
			"y":6660,
			"width":250,
			"height":60
		},
		{
			"id":"cb6f1ab640df3d8b",
			"styleAttributes":{},
			"text":"Как работает",
			"type":"text",
			"x":4540,
			"y":6461,
			"width":250,
			"height":60
		},
		{
			"id":"6763cdae426018f9",
			"styleAttributes":{},
			"text":"Предотвращает автоматическое создание коммита",
			"type":"text",
			"x":4907,
			"y":6801,
			"width":250,
			"height":83
		},
		{
			"id":"64c6ad57eb15a4bb",
			"styleAttributes":{},
			"text":"Это эффективно отменяет изменения, внесенные исходным коммитом",
			"type":"text",
			"x":5518,
			"y":6492,
			"width":250,
			"height":96
		},
		{
			"id":"8b41457af6bb6e9a",
			"styleAttributes":{},
			"text":"Создание нового коммита",
			"type":"text",
			"x":4907,
			"y":6510,
			"width":250,
			"height":60
		},
		{
			"id":"67d1b2fb7ee0a7bb",
			"styleAttributes":{},
			"text":"Сохранение истории",
			"type":"text",
			"x":4907,
			"y":6660,
			"width":250,
			"height":60
		},
		{
			"id":"9487730006143149",
			"styleAttributes":{},
			"text":"Этот коммит обращает изменения, внесенным в определенном коммите",
			"type":"text",
			"x":4540,
			"y":6000,
			"width":250,
			"height":99
		},
		{
			"id":"2cb87fcb75ee102f",
			"styleAttributes":{},
			"text":"git revert",
			"type":"text",
			"x":4242,
			"y":5856,
			"width":250,
			"height":60
		},
		{
			"id":"e9a86899a3fbdad7",
			"styleAttributes":{},
			"text":"Синтаксис",
			"type":"text",
			"x":5160,
			"y":5857,
			"width":250,
			"height":60
		},
		{
			"id":"cf7e0e274f9aadb5",
			"styleAttributes":{},
			"text":"Команда не переписывает историю, он добавляет новый коммит в историю, ясно показывая, что изменения были отменены",
			"type":"text",
			"x":4840,
			"y":5799,
			"width":250,
			"height":175
		},
		{
			"id":"26b35a8e46ffc532",
			"styleAttributes":{},
			"text":"\\<start-commit>^..\\<end-commit>",
			"type":"text",
			"x":4540,
			"y":7152,
			"width":250,
			"height":60
		},
		{
			"id":"41c7a4b017764322",
			"styleAttributes":{},
			"text":"^.. - Включительный диапазон",
			"type":"text",
			"x":5209,
			"y":7153,
			"width":250,
			"height":60
		},
		{
			"id":"09bcfb508e141884",
			"styleAttributes":{},
			"text":"```git\ngit revert <commit-hash>\n```",
			"type":"text",
			"x":5459,
			"y":5858,
			"width":281,
			"height":60
		},
		{
			"id":"ff36ae7ebe57b479",
			"styleAttributes":{},
			"text":"Создание нового коммита, который содержит противоположные изменения",
			"type":"text",
			"x":5209,
			"y":6460,
			"width":250,
			"height":160
		},
		{
			"id":"7a75a81670b03fab",
			"styleAttributes":{},
			"text":"Определение изменений",
			"type":"text",
			"x":4907,
			"y":6370,
			"width":250,
			"height":60
		},
		{
			"id":"ba26adf3e062094d",
			"styleAttributes":{},
			"text":"Показывает изменения между индексом и последним коммитом",
			"type":"text",
			"x":820,
			"y":5988,
			"width":250,
			"height":104
		},
		{
			"id":"8228f17c6cd7d800",
			"styleAttributes":{},
			"text":"Показывает изменения конкретного файла между рабочим каталогом и индексом",
			"type":"text",
			"x":820,
			"y":6104,
			"width":250,
			"height":132
		},
		{
			"id":"a55fa443ab5a59f5",
			"styleAttributes":{},
			"text":"Показывает изменения между двумя ветками",
			"type":"text",
			"x":820,
			"y":6400,
			"width":250,
			"height":60
		},
		{
			"id":"cda3285d22321511",
			"styleAttributes":{},
			"text":"Показывает изменения между двумя коммитами",
			"type":"text",
			"x":820,
			"y":6280,
			"width":250,
			"height":60
		},
		{
			"id":"f304e1101592a27f",
			"styleAttributes":{},
			"text":"Формат вывода",
			"type":"text",
			"x":-543,
			"y":6571,
			"width":250,
			"height":60
		},
		{
			"id":"f740bb537e43c8ac",
			"styleAttributes":{},
			"text":"Вывод представляет собой \"патч\". который показывает какие строки были добавлены, удалены или изменены",
			"type":"text",
			"x":-219,
			"y":6520,
			"width":250,
			"height":162
		},
		{
			"id":"55adabdcbaace023",
			"styleAttributes":{},
			"text":"Показывает N строк контекста вокруг измененных строк",
			"type":"text",
			"x":59,
			"y":7120,
			"width":250,
			"height":100
		},
		{
			"id":"e8787a098154bc40",
			"styleAttributes":{},
			"text":"-U\\<n>",
			"type":"text",
			"x":-238,
			"y":7140,
			"width":250,
			"height":60
		},
		{
			"file":"Cache/Pasted image 20250210121259.png",
			"id":"012541649b308a83",
			"styleAttributes":{},
			"type":"file",
			"x":4465,
			"y":6140,
			"width":400,
			"height":204
		},
		{
			"id":"8bb6b8b11239ab48",
			"styleAttributes":{},
			"text":"Git определяет изменения, внесенные указанным коммитом",
			"type":"text",
			"x":5209,
			"y":6355,
			"width":250,
			"height":90
		},
		{
			"id":"6626afc65d8fe8dc",
			"styleAttributes":{},
			"text":"Показывает изменения между рабочим каталогом и индексом",
			"type":"text",
			"x":820,
			"y":5846,
			"width":250,
			"height":98
		},
		{
			"id":"bfe11efeda6c2a67",
			"styleAttributes":{},
			"text":"```git\ngit diff %commit1% %commit2%\n```",
			"type":"text",
			"x":460,
			"y":6280,
			"width":320,
			"height":60
		},
		{
			"id":"b1a02639e28c635f",
			"styleAttributes":{},
			"text":"```git\ngit diff %branch1% %branch2%\n```",
			"type":"text",
			"x":460,
			"y":6400,
			"width":320,
			"height":60
		},
		{
			"id":"38fab0df98fc47f0",
			"styleAttributes":{},
			"text":"```git\ngit diff %file%\n```",
			"type":"text",
			"x":460,
			"y":6140,
			"width":250,
			"height":60
		},
		{
			"id":"67dc7480f5ed38af",
			"styleAttributes":{},
			"text":"+: Строка была добавлена",
			"type":"text",
			"x":91,
			"y":6571,
			"width":250,
			"height":60
		},
		{
			"id":"092258877ac57ce7",
			"styleAttributes":{},
			"text":"--word-diff",
			"type":"text",
			"x":-238,
			"y":7046,
			"width":250,
			"height":60
		},
		{
			"id":"829377d09ee3f1eb",
			"styleAttributes":{},
			"text":"Выводит изменения с подсветкой синтаксиса",
			"type":"text",
			"x":59,
			"y":6961,
			"width":250,
			"height":60
		},
		{
			"id":"0e781465aab7216f",
			"styleAttributes":{},
			"text":"```git\ngit diff \n```",
			"type":"text",
			"x":460,
			"y":5865,
			"width":250,
			"height":60
		},
		{
			"id":"3100edae265637cd",
			"styleAttributes":{},
			"text":"```git\ngit diff --cached\ngit diff --staged\n```",
			"type":"text",
			"x":460,
			"y":6000,
			"width":250,
			"height":80
		},
		{
			"id":"d7f469665809d01b",
			"styleAttributes":{},
			"text":"Показывает изменения на уровне слов, а не строк",
			"type":"text",
			"x":59,
			"y":7046,
			"width":250,
			"height":60
		},
		{
			"id":"cb8c3e501bfe7ae3",
			"styleAttributes":{},
			"text":"Используется для отмены изменений и перемещения указателя HEAD на другой коммит",
			"type":"text",
			"x":-247,
			"y":7477,
			"width":250,
			"height":132
		},
		{
			"id":"525821dbe247779c",
			"styleAttributes":{},
			"text":"git reset",
			"type":"text",
			"x":-543,
			"y":7513,
			"width":250,
			"height":60
		},
		{
			"id":"52703b3949f0a7cc",
			"styleAttributes":{},
			"text":"Может привести к потере данных, если не были сохранены изменения, которые нужно отменить",
			"type":"text",
			"x":-247,
			"y":7640,
			"width":250,
			"height":127
		},
		{
			"id":"269248fa9ef1f271",
			"styleAttributes":{},
			"text":"Аргументы/опции",
			"type":"text",
			"x":-543,
			"y":6960,
			"width":250,
			"height":60
		},
		{
			"id":"caea21d38b1e7c54",
			"styleAttributes":{},
			"text":"-: Строка была удалена",
			"type":"text",
			"x":91,
			"y":6652,
			"width":250,
			"height":60
		},
		{
			"id":"6a62f13500cd0853",
			"styleAttributes":{},
			"text":"Измененные строки показываются как удаленные, а затем добавленные",
			"type":"text",
			"x":91,
			"y":6740,
			"width":250,
			"height":132
		},
		{
			"id":"45a39aa7e1c32d36",
			"styleAttributes":{},
			"text":"--color",
			"type":"text",
			"x":-240,
			"y":6960,
			"width":250,
			"height":60
		},
		{
			"id":"e9e8a595f2bff8b7",
			"styleAttributes":{},
			"text":"Показывает различия между разными состояниями репозитория, будь то изменения в рабочем каталоге, в индексе или между коммитами",
			"type":"text",
			"x":-211,
			"y":5789,
			"width":250,
			"height":211
		},
		{
			"id":"4d6ca332871d893e",
			"styleAttributes":{},
			"text":"Варианты использования",
			"type":"text",
			"x":130,
			"y":5865,
			"width":250,
			"height":60
		},
		{
			"file":"Cache/Pasted image 20250210114555.png",
			"id":"080581cfd1ba414d",
			"styleAttributes":{},
			"type":"file",
			"x":500,
			"y":6502,
			"width":400,
			"height":360
		},
		{
			"id":"0865603c11f655f1",
			"styleAttributes":{},
			"text":"git diff",
			"type":"text",
			"x":-543,
			"y":5865,
			"width":250,
			"height":60
		},
		{
			"id":"831a9f0faf7afa69",
			"styleAttributes":{},
			"text":"Позволяет увидеть какие изменения еще не добавили в индекс с помощью git add",
			"type":"text",
			"x":1118,
			"y":5827,
			"width":250,
			"height":136
		},
		{
			"id":"17858782da2d7fe1",
			"styleAttributes":{},
			"text":"Позволяет увидеть, какие изменения были подготовлены для следующего коммита",
			"type":"text",
			"x":1118,
			"y":5976,
			"width":250,
			"height":129
		},
		{
			"id":"8fa462f2bc550cf8",
			"styleAttributes":{},
			"text":"Аргументы",
			"type":"text",
			"x":2591,
			"y":5927,
			"width":250,
			"height":60
		},
		{
			"id":"6b570ac4be8d96b5",
			"styleAttributes":{},
			"text":"Синтаксис",
			"type":"text",
			"x":2591,
			"y":5823,
			"width":250,
			"height":60
		},
		{
			"id":"09cafd5f36a786e7",
			"styleAttributes":{},
			"text":"Находит файлы и каталоги в рабочем каталоге, которые не соответствуют ни одному из следующих критериев",
			"type":"text",
			"x":2300,
			"y":6473,
			"width":250,
			"height":154
		},
		{
			"id":"77c13ca4aaa1b501",
			"styleAttributes":{},
			"text":"Все найденные файлы, которые не соответствуют этим требованиям будут удалены",
			"type":"text",
			"x":2300,
			"y":6681,
			"width":250,
			"height":141
		},
		{
			"id":"2cd6a03e264a6fe2",
			"styleAttributes":{},
			"text":"Файл соответствует правилу, указанному в .gitignore",
			"type":"text",
			"x":2640,
			"y":6580,
			"width":250,
			"height":101
		},
		{
			"id":"ace141166e19c9df",
			"styleAttributes":{},
			"text":"Принудительное удаление не отслеживаемых файлов",
			"type":"text",
			"x":3230,
			"y":6040,
			"width":250,
			"height":60
		},
		{
			"id":"36d5e2215e5ae259",
			"styleAttributes":{},
			"text":"-d",
			"type":"text",
			"x":2928,
			"y":6120,
			"width":250,
			"height":60
		},
		{
			"id":"9e773dda96ff5da1",
			"styleAttributes":{},
			"text":"-f или --force",
			"type":"text",
			"x":2928,
			"y":6040,
			"width":250,
			"height":60
		},
		{
			"id":"b0464304e95796ba",
			"styleAttributes":{},
			"text":"Показывает что будет удалено, но не удаляет файлы",
			"type":"text",
			"x":3230,
			"y":5913,
			"width":250,
			"height":89
		},
		{
			"id":"a761e749a03ab831",
			"styleAttributes":{},
			"text":"Рекомендуется использовать перед реальным удалением",
			"type":"text",
			"x":3541,
			"y":5903,
			"width":250,
			"height":108
		},
		{
			"id":"902d1de59169af31",
			"styleAttributes":{},
			"text":"Использовать с осторожностью",
			"type":"text",
			"x":3541,
			"y":6224,
			"width":250,
			"height":60
		},
		{
			"id":"2b79616f218a97fc",
			"styleAttributes":{},
			"text":"Использовать с осторожностью",
			"type":"text",
			"x":3541,
			"y":6040,
			"width":250,
			"height":60
		},
		{
			"id":"3b5f3d778a218fa8",
			"styleAttributes":{},
			"text":"```git\ngit clean [options]\n```",
			"type":"text",
			"x":2900,
			"y":5824,
			"width":250,
			"height":60
		},
		{
			"id":"866f1bbdf151f570",
			"styleAttributes":{},
			"text":"-n или --dry-run",
			"type":"text",
			"x":2928,
			"y":5928,
			"width":250,
			"height":60
		},
		{
			"id":"6c9954e98ebcc6ae",
			"styleAttributes":{},
			"text":"Файл отслеживается Git'ом, т.е. добавлен в индекс",
			"type":"text",
			"x":2640,
			"y":6453,
			"width":250,
			"height":97
		},
		{
			"id":"2be63d8f88c586ff",
			"styleAttributes":{},
			"text":"Удаляет указанный файл из индекса и рабочего каталога",
			"type":"text",
			"x":2993,
			"y":7489,
			"width":250,
			"height":104
		},
		{
			"id":"63cb197a61b2079b",
			"styleAttributes":{},
			"text":"git rm",
			"type":"text",
			"x":1666,
			"y":7511,
			"width":250,
			"height":60
		},
		{
			"id":"01635d6942ee1320",
			"styleAttributes":{},
			"text":"Сценарии использования",
			"type":"text",
			"x":2300,
			"y":7511,
			"width":250,
			"height":60
		},
		{
			"id":"5ea242b1d91916dc",
			"styleAttributes":{},
			"text":"Удаляет файлы из репозитория",
			"type":"text",
			"x":1980,
			"y":7511,
			"width":250,
			"height":60
		},
		{
			"id":"1ca800391250fa92",
			"styleAttributes":{},
			"text":"Удаляет также игнорируемые в .gitignore файлы ",
			"type":"text",
			"x":3230,
			"y":6200,
			"width":250,
			"height":109
		},
		{
			"id":"19aff75392dad681",
			"styleAttributes":{},
			"text":"Запускает интерактивный режим, в котором можно выбирать файлы для удаления",
			"type":"text",
			"x":3230,
			"y":6320,
			"width":250,
			"height":116
		},
		{
			"id":"edb481644ad2993d",
			"styleAttributes":{},
			"text":"Удаляет также не отслеживаемые каталоги",
			"type":"text",
			"x":3230,
			"y":6120,
			"width":250,
			"height":60
		},
		{
			"id":"7860c5b73ff9a85d",
			"styleAttributes":{},
			"text":"-i или --interactive",
			"type":"text",
			"x":2928,
			"y":6348,
			"width":250,
			"height":60
		},
		{
			"id":"fa50b62cc4947d41",
			"styleAttributes":{},
			"text":"-x",
			"type":"text",
			"x":2928,
			"y":6224,
			"width":250,
			"height":60
		},
		{
			"id":"fda05315a0d72679",
			"styleAttributes":{},
			"text":"Перемещает указатель HEAD на указанный коммит, оставляя индекс и рабочий каталог без изменений",
			"type":"text",
			"x":1000,
			"y":7470,
			"width":250,
			"height":147
		},
		{
			"id":"6e57468abbe20951",
			"styleAttributes":{},
			"text":"Режим по умолчанию. Перемещает указатель HEAD на указанный коммит и очищает индекс",
			"type":"text",
			"x":1000,
			"y":7649,
			"width":250,
			"height":120
		},
		{
			"id":"22a0a6cb099953ab",
			"styleAttributes":{},
			"text":"```git\ngit rm <file>\n```",
			"type":"text",
			"x":2620,
			"y":7511,
			"width":250,
			"height":60
		},
		{
			"id":"14dacf0a0f578afa",
			"styleAttributes":{},
			"text":"Считается \"опасной\" командой, которая может привести к потере данных, если ее использовать неправильно",
			"type":"text",
			"x":1641,
			"y":5965,
			"width":250,
			"height":155
		},
		{
			"id":"35a789d4c188150e",
			"styleAttributes":{},
			"text":"Как работает",
			"type":"text",
			"x":1960,
			"y":6520,
			"width":250,
			"height":60
		},
		{
			"id":"3b98f19e254e81a6",
			"styleAttributes":{},
			"text":"Могут быть временные файлы, результаты сборки, или другие файлы которые не нужно добавлять в репозиторий",
			"type":"text",
			"x":2270,
			"y":5780,
			"width":250,
			"height":147
		},
		{
			"id":"cb2cdff6d77c5259",
			"styleAttributes":{},
			"text":"Используется для удаления файлов, которые не отслеживаются Git'ом",
			"type":"text",
			"x":1960,
			"y":5802,
			"width":250,
			"height":102
		},
		{
			"id":"cc9d4544691a100e",
			"styleAttributes":{},
			"text":"git clean",
			"type":"text",
			"x":1641,
			"y":5823,
			"width":250,
			"height":60
		},
		{
			"id":"14b49c702927784a",
			"styleAttributes":{},
			"text":"Изменения, которые были в более поздних коммитах, остаются в индексе, готовые к новому коммиту",
			"type":"text",
			"x":1320,
			"y":7465,
			"width":250,
			"height":158
		},
		{
			"id":"a080a9fdccd3272a",
			"styleAttributes":{},
			"text":"Изменения, которые были в более поздних коммитах - остаются в каталоге, но не будут добавлены в индекс",
			"type":"text",
			"x":1320,
			"y":7636,
			"width":250,
			"height":146
		},
		{
			"id":"52dfae8e8da255f5",
			"styleAttributes":{},
			"text":"Изменения, которые были в более поздних коммитах, теряются",
			"type":"text",
			"x":1320,
			"y":7801,
			"width":250,
			"height":92
		},
		{
			"id":"700183b19d274f39",
			"styleAttributes":{},
			"text":"Перемещает указатель HEAD на указанный коммит, очищает индекс и рабочий каталог",
			"type":"text",
			"x":1000,
			"y":7785,
			"width":250,
			"height":125
		},
		{
			"id":"72b0799ae3962db4",
			"styleAttributes":{},
			"text":"Удаляет указанный stash",
			"type":"text",
			"x":5780,
			"y":4700,
			"width":250,
			"height":60
		},
		{
			"id":"b3f8d65f078caf48",
			"styleAttributes":{},
			"text":"Удаляет все stash'и",
			"type":"text",
			"x":5780,
			"y":4789,
			"width":250,
			"height":60
		},
		{
			"id":"bce5ac4e48d7264b",
			"styleAttributes":{},
			"text":"```git\ngit stash apply\n```",
			"type":"text",
			"x":5480,
			"y":4458,
			"width":250,
			"height":60
		},
		{
			"id":"850a0cb837045121",
			"styleAttributes":{},
			"text":"Применяет указанный stash, не удаляет его из списка",
			"type":"text",
			"x":5780,
			"y":4436,
			"width":250,
			"height":103
		},
		{
			"id":"bb633b7a16d40133",
			"styleAttributes":{},
			"text":"```git\ngit stash pop\n```",
			"type":"text",
			"x":5480,
			"y":4351,
			"width":250,
			"height":60
		},
		{
			"id":"462a87876dc3c2ab",
			"styleAttributes":{},
			"text":"```git\ngit stash create %msg%\n```",
			"type":"text",
			"x":5480,
			"y":4883,
			"width":263,
			"height":60
		},
		{
			"id":"2fbf220e86037496",
			"styleAttributes":{},
			"text":"Создает новый stash, но не сохраняет в него текущие изменения",
			"type":"text",
			"x":5780,
			"y":4865,
			"width":250,
			"height":96
		},
		{
			"id":"a65060ae3e8cb322",
			"styleAttributes":{},
			"text":"Показывает список всех сохраненных stash'ей, каждый имеет свой индекс",
			"type":"text",
			"x":5780,
			"y":4546,
			"width":250,
			"height":118
		},
		{
			"id":"40d1942eb61722be",
			"styleAttributes":{},
			"text":"Полезен при создании пустого stash'a для каких-то целей",
			"type":"text",
			"x":6075,
			"y":4864,
			"width":250,
			"height":98
		},
		{
			"id":"a4a64a01eea04774",
			"styleAttributes":{},
			"text":"stash@{1} | stash@{2}",
			"type":"text",
			"x":6075,
			"y":4575,
			"width":250,
			"height":60
		},
		{
			"id":"d6a7298070f63c8b",
			"styleAttributes":{},
			"text":"```git\ngit stash drop <name>\n```",
			"type":"text",
			"x":5480,
			"y":4700,
			"width":250,
			"height":60
		},
		{
			"id":"a379a1aa1a229f3e",
			"styleAttributes":{},
			"text":"```git\ngit stash clear\n```",
			"type":"text",
			"x":5480,
			"y":4789,
			"width":250,
			"height":60
		},
		{
			"id":"3ba1d28c52b2c23a",
			"styleAttributes":{},
			"text":"```git\ngit stash list\n```",
			"type":"text",
			"x":5480,
			"y":4575,
			"width":250,
			"height":60
		},
		{
			"id":"eb137d359d0d1efa",
			"styleAttributes":{},
			"text":"```git\ngit stash push -m \"My changes\"\n```",
			"type":"text",
			"x":6260,
			"y":4376,
			"width":320,
			"height":70
		},
		{
			"id":"ce0bfc3031345b1f",
			"styleAttributes":{},
			"text":"```git\ngit stash push \"My changes\"\n```",
			"type":"text",
			"x":6270,
			"y":4486,
			"width":300,
			"height":60
		},
		{
			"id":"dbfa68770fa6dc73",
			"styleAttributes":{},
			"text":"```git\ngit stash push -u\n```",
			"type":"text",
			"x":6295,
			"y":4265,
			"width":250,
			"height":60
		},
		{
			"id":"97a584d66f82282d",
			"styleAttributes":{},
			"text":"```git\ngit stash push\n```",
			"type":"text",
			"x":5780,
			"y":4265,
			"width":250,
			"height":60
		},
		{
			"id":"c2b2f970a0153de6",
			"styleAttributes":{},
			"text":"Применяет последний сохраненный stash и удаляет его из списка",
			"type":"text",
			"x":5780,
			"y":4333,
			"width":250,
			"height":96
		},
		{
			"id":"652e8894a8226966",
			"styleAttributes":{},
			"text":"Сохранит также не отслеживаемые файлы",
			"type":"text",
			"x":6640,
			"y":4265,
			"width":250,
			"height":60
		},
		{
			"id":"4899fd65e8997943",
			"styleAttributes":{},
			"text":"```git\ngit stash\n```",
			"type":"text",
			"x":5480,
			"y":4265,
			"width":250,
			"height":60
		},
		{
			"id":"4b95a12ac317328c",
			"styleAttributes":{},
			"text":"Основные команды",
			"type":"text",
			"x":5140,
			"y":4264,
			"width":250,
			"height":60
		},
		{
			"id":"3698a4d2d03ccee9",
			"styleAttributes":{},
			"text":"Сохраняет текущие изменения в стэш (обе команды)",
			"type":"text",
			"x":6295,
			"y":4116,
			"width":250,
			"height":91
		},
		{
			"id":"c2b1bfa49429f3cb",
			"styleAttributes":{},
			"text":"Скачивает изменения из всех веток указанного удаленного репозитория и пытается слить соответствующую удаленную ветку с текущей локальной веткой",
			"type":"text",
			"x":6562,
			"y":9570,
			"width":250,
			"height":236
		},
		{
			"id":"4f2a67f72155f75c",
			"styleAttributes":{},
			"text":"```git\ngit pull\n```",
			"type":"text",
			"x":6040,
			"y":9396,
			"width":250,
			"height":61
		},
		{
			"id":"9ec24d16adeb1633",
			"styleAttributes":{},
			"text":"Если текущая ветка настроена на отслеживание удаленной ветки, то команда скачает изменения из соответствующей ветки и попытается их слить",
			"type":"text",
			"x":6562,
			"y":9326,
			"width":250,
			"height":200
		},
		{
			"id":"3c17a8393667263a",
			"styleAttributes":{},
			"text":"Создает более \"линейную\" историю коммитов",
			"type":"text",
			"x":6900,
			"y":10069,
			"width":250,
			"height":76
		},
		{
			"id":"08f54b546c608834",
			"styleAttributes":{},
			"text":"Сливает изменения (merge)",
			"type":"text",
			"x":6040,
			"y":9160,
			"width":250,
			"height":60
		},
		{
			"id":"7c0744dc53925cd4",
			"styleAttributes":{},
			"text":"Затем автоматически пытается слить скачанные изменения с текущей локальной веткой",
			"type":"text",
			"x":6336,
			"y":9128,
			"width":250,
			"height":125
		},
		{
			"id":"e7b0605a52e1292d",
			"styleAttributes":{},
			"text":"Скачивает все коммиты, ветки и другие объекты из удаленного репозитория, которые отсутствуют в локальном",
			"type":"text",
			"x":6336,
			"y":8931,
			"width":250,
			"height":161
		},
		{
			"id":"4318e36c0b082ce4",
			"styleAttributes":{},
			"text":"Если текущая локальная ветка отслеживает удаленную ветку, pull по умолчанию пытается слить изменения из соответствующей удаленной ветки",
			"type":"text",
			"x":6650,
			"y":9081,
			"width":250,
			"height":218
		},
		{
			"id":"279e4ebb09c973d3",
			"styleAttributes":{},
			"text":"Git pull - сокращение для двух команд: fetch и merge",
			"type":"text",
			"x":5356,
			"y":8747,
			"width":250,
			"height":86
		},
		{
			"id":"259fc21c850b2ad5",
			"styleAttributes":{},
			"text":"```git\ngit pull <repo name> <branch name>\n```",
			"type":"text",
			"x":6040,
			"y":9906,
			"width":377,
			"height":60
		},
		{
			"id":"74e565027a4d6873",
			"styleAttributes":{},
			"text":"```git\ngit pull --rebase <repo name> <branch name>\n```",
			"type":"text",
			"x":6040,
			"y":10077,
			"width":437,
			"height":60
		},
		{
			"id":"90d8268eb1079407",
			"styleAttributes":{},
			"text":"Скачивает изменения (fetch)",
			"type":"text",
			"x":6040,
			"y":8981,
			"width":250,
			"height":60
		},
		{
			"id":"28625e1866bb4a16",
			"styleAttributes":{},
			"text":"Скачивает изменения только из указанной удаленной ветки и пытается их слить с текущей локальной веткой",
			"type":"text",
			"x":6562,
			"y":9845,
			"width":250,
			"height":182
		},
		{
			"id":"b67a74f9412ad0bb",
			"styleAttributes":{},
			"text":"Fetch загружает все новые коммиты, которые есть в удаленном репозитории, но отсутствуют в локальном",
			"type":"text",
			"x":3866,
			"y":8678,
			"width":250,
			"height":156
		},
		{
			"id":"340ca91b206c59da",
			"styleAttributes":{},
			"text":"Fetch обновляет локальные копии удаленных веток. Например: origin/main, origin/develop",
			"type":"text",
			"x":3866,
			"y":8852,
			"width":250,
			"height":146
		},
		{
			"id":"b04f7d2e9468d5d1",
			"styleAttributes":{},
			"text":"Можно использовать в простых случаях, когда изменения в удаленном репозитории происходят нечасто",
			"type":"text",
			"x":5356,
			"y":9193,
			"width":250,
			"height":157
		},
		{
			"id":"6090359a0f24935e",
			"styleAttributes":{},
			"text":"Можно использовать когда необходимо быстро получить и слить изменения из удаленного репозитория, и есть уверенность в том, что не будет конфликтов или готовы решить",
			"type":"text",
			"x":5356,
			"y":8923,
			"width":250,
			"height":243
		},
		{
			"file":"Cache/Pasted image 20250210150525.png",
			"id":"d0506a5c7c3efa09",
			"styleAttributes":{},
			"type":"file",
			"x":5676,
			"y":8678,
			"width":400,
			"height":225
		},
		{
			"id":"24e74f7184b78eeb",
			"styleAttributes":{},
			"text":"Функциональность команды",
			"type":"text",
			"x":5697,
			"y":8981,
			"width":250,
			"height":60
		},
		{
			"id":"0157206cecbfb9b3",
			"styleAttributes":{},
			"text":"git fetch + git merge - предоставляет больше контроля, можно сначала посмотреть изменения через git log / git diff, после прописать fetch",
			"type":"text",
			"x":5056,
			"y":9491,
			"width":250,
			"height":185
		},
		{
			"id":"e9d45b8d0a96e8ba",
			"styleAttributes":{},
			"text":"Используется для получения изменений из удаленного репозитория и их автоматического слияния с текущей локальной веткой",
			"type":"text",
			"x":5056,
			"y":8696,
			"width":250,
			"height":187
		},
		{
			"id":"fb116d6e8118e6d6",
			"styleAttributes":{},
			"text":"git pull - автоматически скачивает и сливает изменения",
			"type":"text",
			"x":5056,
			"y":9166,
			"width":250,
			"height":105
		},
		{
			"id":"5712df5b0672a073",
			"styleAttributes":{},
			"text":"Скачивает изменения и применяет их с помощью перебазирования (rebase) вместо слияния (rebase). ",
			"type":"text",
			"x":6562,
			"y":10048,
			"width":250,
			"height":118
		},
		{
			"id":"70ab3644bc536c26",
			"styleAttributes":{},
			"text":"Ветки являются \"зеркалом\" веток удаленного репозитория и хранятся локально",
			"type":"text",
			"x":4186,
			"y":8864,
			"width":250,
			"height":123
		},
		{
			"id":"aa4023f1ae3d82e3",
			"styleAttributes":{},
			"text":"pull vs fetch + merge",
			"type":"text",
			"x":4716,
			"y":9366,
			"width":250,
			"height":60
		},
		{
			"id":"ccb612d74f97dac4",
			"styleAttributes":{},
			"text":"git pull",
			"type":"text",
			"x":4716,
			"y":8759,
			"width":250,
			"height":60
		},
		{
			"id":"e595a338136a33f3",
			"styleAttributes":{},
			"text":"Переключается на указанную ветку",
			"type":"text",
			"x":7100,
			"y":11100,
			"width":250,
			"height":60
		},
		{
			"id":"7c22c3124cf3e4f0",
			"styleAttributes":{},
			"text":"Показывает список существующих веток",
			"type":"text",
			"x":7100,
			"y":10948,
			"width":250,
			"height":60
		},
		{
			"id":"a20421ae3bc3c7b2",
			"styleAttributes":{},
			"text":"Смерживание позволяет объединить новую функциональность, разработанную в отдельной ветке с основной веткой разработки",
			"type":"text",
			"x":7900,
			"y":10320,
			"width":250,
			"height":208
		},
		{
			"id":"a8ccc1c395ec1372",
			"styleAttributes":{},
			"text":"Интеграция функциональности",
			"type":"text",
			"x":7506,
			"y":10394,
			"width":250,
			"height":60
		},
		{
			"id":"fb1f194b5eb5a463",
			"styleAttributes":{},
			"text":"Смерживание является основой для совместной работы над проектом, позволяя объединить изменения",
			"type":"text",
			"x":7900,
			"y":10791,
			"width":250,
			"height":159
		},
		{
			"id":"072a69c7f3d2b60f",
			"styleAttributes":{},
			"text":"Исправление ошибок",
			"type":"text",
			"x":7506,
			"y":10640,
			"width":250,
			"height":60
		},
		{
			"id":"7e0a5fa9c2297623",
			"styleAttributes":{},
			"text":"Сливает указанную ветку с текущей",
			"type":"text",
			"x":7100,
			"y":11340,
			"width":250,
			"height":60
		},
		{
			"id":"b32aba486fc64b2d",
			"styleAttributes":{},
			"text":"Перебазирует текущую ветку на указанную",
			"type":"text",
			"x":7100,
			"y":11420,
			"width":250,
			"height":60
		},
		{
			"id":"c76252d02d7281b4",
			"styleAttributes":{},
			"text":"Создает новую ветку и сразу переключается на нее",
			"type":"text",
			"x":7100,
			"y":11200,
			"width":250,
			"height":111
		},
		{
			"id":"b524343276cbf075",
			"styleAttributes":{},
			"text":"Смысл смерживания",
			"type":"text",
			"x":7125,
			"y":10640,
			"width":250,
			"height":60
		},
		{
			"id":"1bfd613fa880ce2a",
			"styleAttributes":{},
			"text":"Создает новую ветку",
			"type":"text",
			"x":7100,
			"y":11020,
			"width":250,
			"height":60
		},
		{
			"file":"Cache/Pasted image 20250211115224.png",
			"id":"5b960225dc4ead65",
			"styleAttributes":{},
			"type":"file",
			"x":7060,
			"y":11741,
			"width":278,
			"height":400
		},
		{
			"id":"8e806de2ef5e179f",
			"styleAttributes":{},
			"text":"Принудительное удаление ветки (даже если не была слита)",
			"type":"text",
			"x":7100,
			"y":11580,
			"width":250,
			"height":101
		},
		{
			"id":"11cce537b0f4176a",
			"styleAttributes":{},
			"text":"Удаляет указанную ветку (если была слита)",
			"type":"text",
			"x":7100,
			"y":11500,
			"width":250,
			"height":60
		},
		{
			"id":"488ad4bfb9b3a181",
			"styleAttributes":{},
			"text":"При помощи команд Git пытается автоматически объединить изменения, могут быть конфликты, но они решаемы",
			"type":"text",
			"x":6755,
			"y":11870,
			"width":250,
			"height":143
		},
		{
			"id":"d95613180f65e447",
			"styleAttributes":{},
			"text":"Используется для отправки изменений, сделанных в отдельной ветке для новой функциональности",
			"type":"text",
			"x":1617,
			"y":11731,
			"width":250,
			"height":156
		},
		{
			"id":"4f3f7ded5a25f3da",
			"styleAttributes":{},
			"text":"```git\ngit branch\n```",
			"type":"text",
			"x":6716,
			"y":10948,
			"width":250,
			"height":60
		},
		{
			"id":"d866c865240cad6a",
			"styleAttributes":{},
			"text":"Тоже самое что и самый первый пункт, но есть флаг -u. Он устанавливает отслеживание между локальной и удаленной ветками",
			"type":"text",
			"x":1267,
			"y":11917,
			"width":250,
			"height":175
		},
		{
			"id":"45524a72dca0cf5d",
			"styleAttributes":{},
			"text":"Принудительная отправка. Она перезаписывает удаленную ветку, даже если это приведет к потере коммитов у других разработчиков",
			"type":"text",
			"x":1267,
			"y":12111,
			"width":250,
			"height":195
		},
		{
			"id":"504cf01fcfd0380c",
			"styleAttributes":{},
			"text":"Отправляет локальную ветку в удаленную ветку origin репозитория",
			"type":"text",
			"x":1267,
			"y":11762,
			"width":250,
			"height":94
		},
		{
			"id":"3ba66af74d217811",
			"styleAttributes":{},
			"text":"После выполнения этой команды можно использовать просто git push без указания имен, и Git будет знать куда отправлять",
			"type":"text",
			"x":1617,
			"y":11911,
			"width":250,
			"height":188
		},
		{
			"id":"23ec193d09040165",
			"styleAttributes":{},
			"text":"Использовать с крайней осторожностью",
			"type":"text",
			"x":1617,
			"y":12179,
			"width":250,
			"height":60
		},
		{
			"id":"b621a982a28fa29c",
			"styleAttributes":{},
			"text":"Совместная работа",
			"type":"text",
			"x":7506,
			"y":10840,
			"width":250,
			"height":60
		},
		{
			"id":"17e96ff3870160fe",
			"styleAttributes":{},
			"text":"Позволяет интегрировать исправления ошибок, сделанные в отдельной ветке",
			"type":"text",
			"x":7900,
			"y":10604,
			"width":250,
			"height":133
		},
		{
			"id":"b91d237bfe62edbd",
			"styleAttributes":{},
			"text":"Как работает смерживание",
			"type":"text",
			"x":6444,
			"y":11911,
			"width":250,
			"height":60
		},
		{
			"id":"8e9a3f80697a2e93",
			"styleAttributes":{},
			"text":"Самый частый случай, когда нужно обновить основную ветку (или другую) на удаленном сервере",
			"type":"text",
			"x":1617,
			"y":11551,
			"width":250,
			"height":153
		},
		{
			"id":"1478029b6840b920",
			"styleAttributes":{},
			"text":"```git\ngit switch -c <branch name>\n\n# Example\ngit switch -c feature/new-feature\ngit switch --create bugfix/login-error\n```",
			"type":"text",
			"x":760,
			"y":13090,
			"width":400,
			"height":160
		},
		{
			"id":"0056d5101e263453",
			"styleAttributes":{},
			"text":"```git\ngit switch <branch_name>\n\n# Example\ngit switch main # branch main\ngit switch develop # branch develop\ngit switch feature/new-login # branch feature/new-login\n``` ",
			"type":"text",
			"x":760,
			"y":12850,
			"width":449,
			"height":200
		},
		{
			"id":"f6c62345a21ec815",
			"styleAttributes":{},
			"text":"Отправляет локальную ветку в удаленную ветку",
			"type":"text",
			"x":1267,
			"y":11598,
			"width":250,
			"height":60
		},
		{
			"id":"c8a56aa8e891d7f0",
			"styleAttributes":{},
			"text":"\\<remote branch>",
			"type":"text",
			"x":1156,
			"y":11184,
			"width":250,
			"height":60
		},
		{
			"id":"4717f4d2326b7b15",
			"styleAttributes":{},
			"text":"\\<local branch>",
			"type":"text",
			"x":1156,
			"y":11054,
			"width":250,
			"height":60
		},
		{
			"id":"dc8d51f2d6f38cbd",
			"styleAttributes":{},
			"text":"Имя ветки в удаленном репозитории, куда нужно отправить коммиты",
			"type":"text",
			"x":1449,
			"y":11171,
			"width":250,
			"height":86
		},
		{
			"id":"0279f7058632ec1b",
			"styleAttributes":{},
			"text":"Имя ветки в локальном репозитории, коммиты из которой нужно отправить",
			"type":"text",
			"x":1449,
			"y":11037,
			"width":250,
			"height":94
		},
		{
			"id":"7dbc23413a6b402e",
			"styleAttributes":{},
			"text":"Теги используются для маркировки релизов или важных этапов разработки",
			"type":"text",
			"x":1617,
			"y":12311,
			"width":250,
			"height":121
		},
		{
			"id":"ce417338f44ae711",
			"styleAttributes":{},
			"text":"Отправляет все локальные теги в удаленный репозиторий",
			"type":"text",
			"x":1267,
			"y":12322,
			"width":250,
			"height":99
		},
		{
			"id":"9d71b1771867703a",
			"styleAttributes":{},
			"text":"Также обновит файлы в рабочем каталоге, чтобы они соответствовали состоянию указанной ветки",
			"type":"text",
			"x":1267,
			"y":12875,
			"width":250,
			"height":150
		},
		{
			"id":"1f3980603d09c6a9",
			"styleAttributes":{},
			"text":"Также обновит указатель HEAD, чтобы он указывал на эту ветку",
			"type":"text",
			"x":1580,
			"y":12897,
			"width":250,
			"height":106
		},
		{
			"id":"e196168c1b5965a0",
			"styleAttributes":{},
			"text":"Команда создаст новую ветку с указанным именем, ответвленную от текущей ветки и сразу же переключит на нее",
			"type":"text",
			"x":1267,
			"y":13095,
			"width":250,
			"height":150
		},
		{
			"id":"cf6263a82929ef34",
			"styleAttributes":{},
			"text":"```git\ngit push --force origin main\n```",
			"type":"text",
			"x":696,
			"y":12178,
			"width":330,
			"height":60
		},
		{
			"id":"26546d6e63c165bd",
			"styleAttributes":{},
			"text":"Синтаксис",
			"type":"text",
			"x":683,
			"y":10735,
			"width":250,
			"height":60
		},
		{
			"id":"85aab92d46baa6ba",
			"styleAttributes":{},
			"text":"```git\ngit push <repo name> <local branch> <remote branch>\n```",
			"type":"text",
			"x":1010,
			"y":10735,
			"width":542,
			"height":60
		},
		{
			"id":"8a4365dc2a2396ad",
			"styleAttributes":{},
			"text":"Короткое имя удаленного репозитория",
			"type":"text",
			"x":1449,
			"y":10897,
			"width":250,
			"height":60
		},
		{
			"id":"5c1738490c2597b3",
			"styleAttributes":{},
			"text":"Создает новую ветку в удаленном репозитории и отправляет туда коммиты из указанной локальной ветки",
			"type":"text",
			"x":1267,
			"y":12431,
			"width":250,
			"height":159
		},
		{
			"id":"ff94b9ee37116768",
			"styleAttributes":{},
			"text":"```git\ngit push origin <local branch>:<new local branch>\n```",
			"type":"text",
			"x":696,
			"y":12480,
			"width":490,
			"height":60
		},
		{
			"id":"2a37040165429c9d",
			"styleAttributes":{},
			"text":"```git\ngit push origin --tags\n```",
			"type":"text",
			"x":696,
			"y":12341,
			"width":285,
			"height":60
		},
		{
			"id":"c17f0fcc27357583",
			"styleAttributes":{},
			"text":"Создание новой ветки на основе удаленной ветки и переключение на нее",
			"type":"text",
			"x":460,
			"y":13480,
			"width":250,
			"height":101
		},
		{
			"id":"f16a9175d35759d8",
			"styleAttributes":{},
			"text":"```git\ngit switch -c <local branch> <remote repo/remote branch>\n\n# Example\ngit switch -c feature/tracking origin/feature/remote-feature\n```",
			"type":"text",
			"x":789,
			"y":13462,
			"width":593,
			"height":137
		},
		{
			"id":"0b4010b4506ae4c0",
			"styleAttributes":{},
			"text":"Команда создаст локальную ветку feature/tracking, основанную на указанной удаленной ветке и переключит на нее",
			"type":"text",
			"x":1455,
			"y":13442,
			"width":250,
			"height":178
		},
		{
			"id":"40527d20ad1bb76a",
			"styleAttributes":{},
			"text":"Вместо \"-с\" можно прописать \"--create\"",
			"type":"text",
			"x":835,
			"y":13300,
			"width":250,
			"height":60
		},
		{
			"id":"d9a18b762f54165e",
			"styleAttributes":{},
			"text":"```git\ngit push -u origin main\n```",
			"type":"text",
			"x":696,
			"y":11974,
			"width":296,
			"height":60
		},
		{
			"id":"40ab7158582afe61",
			"styleAttributes":{},
			"text":"```git\ngit push origin feature/new-feature\n```",
			"type":"text",
			"x":696,
			"y":11779,
			"width":376,
			"height":60
		},
		{
			"id":"e3a90ef743dea831",
			"styleAttributes":{},
			"text":"```git\ngit push origin main\n```",
			"type":"text",
			"x":696,
			"y":11597,
			"width":250,
			"height":60
		},
		{
			"id":"52b263493a83e626",
			"styleAttributes":{},
			"text":"Git push отправляет те коммиты, которых нет в удаленном репозитории",
			"type":"text",
			"x":361,
			"y":11058,
			"width":250,
			"height":93
		},
		{
			"id":"a927eb176f42534c",
			"styleAttributes":{},
			"text":"\\<repo name>",
			"type":"text",
			"x":1156,
			"y":10897,
			"width":250,
			"height":60
		},
		{
			"id":"c10e4afdcac94353",
			"styleAttributes":{},
			"text":"Наиболее распространенные случаи использования",
			"type":"text",
			"x":361,
			"y":11571,
			"width":250,
			"height":104
		},
		{
			"id":"34b6f3f5dec54c8c",
			"styleAttributes":{},
			"text":"Является ключевой операцией для обмена изменениями с другими разработчиками и для сохранения резервной копии кода на удаленном сервере",
			"type":"text",
			"x":52,
			"y":10660,
			"width":250,
			"height":210
		},
		{
			"id":"067d7943bf498c0b",
			"styleAttributes":{},
			"text":"Используется для отправки локальных коммитов в удаленный репозиторий",
			"type":"text",
			"x":-258,
			"y":10706,
			"width":250,
			"height":117
		},
		{
			"id":"ea345d1ed0ea8e4e",
			"styleAttributes":{},
			"text":"git push",
			"type":"text",
			"x":-571,
			"y":10734,
			"width":250,
			"height":60
		},
		{
			"id":"87052602459b9947",
			"styleAttributes":{},
			"text":"git switch",
			"type":"text",
			"x":-571,
			"y":12920,
			"width":250,
			"height":60
		},
		{
			"file":"Cache/Pasted image 20250211125348.png",
			"id":"4b51dd1681fb08ee",
			"styleAttributes":{},
			"type":"file",
			"x":-646,
			"y":13090,
			"width":400,
			"height":122
		},
		{
			"id":"b4691600416e47f3",
			"styleAttributes":{},
			"text":"Варианты использования",
			"type":"text",
			"x":140,
			"y":12920,
			"width":250,
			"height":60
		},
		{
			"id":"6991cee2b42f53f3",
			"styleAttributes":{},
			"text":"Что делает",
			"type":"text",
			"x":361,
			"y":10735,
			"width":250,
			"height":60
		},
		{
			"id":"2618f0affc351bb1",
			"styleAttributes":{},
			"text":"Git push берет коммиты из локальной ветки и отправляет их в соответствующую ветку удаленного репозитория",
			"type":"text",
			"x":361,
			"y":10871,
			"width":250,
			"height":145
		},
		{
			"id":"f957a951903d5817",
			"styleAttributes":{},
			"text":"Очистка истории локальной ветки",
			"type":"text",
			"x":4260,
			"y":13155,
			"width":250,
			"height":60
		},
		{
			"id":"85f6401ba718cef2",
			"styleAttributes":{},
			"text":"fixup/f - тоже самое что и \"s\", но отбрасывается сообщение текущего коммита",
			"type":"text",
			"x":5100,
			"y":13698,
			"width":250,
			"height":125
		},
		{
			"id":"f6ae0a28da0ffc3a",
			"styleAttributes":{},
			"text":"pick/p - Оставить коммит как есть",
			"type":"text",
			"x":5100,
			"y":13304,
			"width":250,
			"height":60
		},
		{
			"id":"21ea5862e425a414",
			"styleAttributes":{},
			"text":"Дальше можно выбрать действия для коммита",
			"type":"text",
			"x":4563,
			"y":13304,
			"width":250,
			"height":60
		},
		{
			"id":"7b7bdab2f70ba66f",
			"styleAttributes":{},
			"text":"Позволяет держать ветку FEATURE в актуальном состоянии относительно MAIN, для избежания конфликтов при слиянии",
			"type":"text",
			"x":4875,
			"y":12926,
			"width":250,
			"height":164
		},
		{
			"id":"1683ecc66982fbaa",
			"styleAttributes":{},
			"text":"Позволяет объединять несколько коммитов в один, переименовывать коммиты или удалять ненужные",
			"type":"text",
			"x":4875,
			"y":13102,
			"width":250,
			"height":167
		},
		{
			"id":"1973b16669c63cb8",
			"styleAttributes":{},
			"text":"Создание новой ветки и переключение на него",
			"type":"text",
			"x":460,
			"y":13140,
			"width":250,
			"height":60
		},
		{
			"id":"64c966cbe76ba39a",
			"styleAttributes":{},
			"text":"Переключение на существующую ветку",
			"type":"text",
			"x":460,
			"y":12920,
			"width":250,
			"height":60
		},
		{
			"id":"375c8d5e0124a2fd",
			"styleAttributes":{},
			"text":"Используется для переключения между ветками",
			"type":"text",
			"x":-200,
			"y":12900,
			"width":250,
			"height":100
		},
		{
			"id":"b57288f36aa0b379",
			"styleAttributes":{},
			"text":"Switch - только для работы с ветками, checkout - чуть шире функционал",
			"type":"text",
			"x":-571,
			"y":13326,
			"width":250,
			"height":136
		},
		{
			"id":"01a1c02eeda9c988",
			"styleAttributes":{},
			"text":"Разработчик должен вручную отредактировать файл, удалив маркеры и оставив нужный код",
			"type":"text",
			"x":2800,
			"y":12894,
			"width":250,
			"height":122
		},
		{
			"id":"7f80f7ba16fab74a",
			"styleAttributes":{},
			"text":"Ситуация, в которой Git не может автоматически определить, как объединить изменения в одном и том же файле",
			"type":"text",
			"x":2460,
			"y":12906,
			"width":250,
			"height":161
		},
		{
			"id":"e035f3cb5b76ce94",
			"styleAttributes":{},
			"text":"edit/e - Остановить перебазирование для внесения дополнительных изменений в коммит",
			"type":"text",
			"x":5100,
			"y":13458,
			"width":250,
			"height":132
		},
		{
			"id":"f926b90149f5e725",
			"styleAttributes":{},
			"text":"```git\ngit checkout feature\ngit rebase -i HEAD~3\n```",
			"type":"text",
			"x":4560,
			"y":13139,
			"width":250,
			"height":93
		},
		{
			"id":"6f77db0e55321374",
			"styleAttributes":{},
			"text":"Интеграция разработки из MAIN в ветку FEATURE",
			"type":"text",
			"x":4260,
			"y":12977,
			"width":250,
			"height":60
		},
		{
			"id":"6917285414279c88",
			"styleAttributes":{},
			"text":"Перенос ветки на другую базу",
			"type":"text",
			"x":4155,
			"y":13460,
			"width":250,
			"height":60
		},
		{
			"id":"797ddb0ff3536f33",
			"styleAttributes":{},
			"text":"```git\ngit rebase --onto <newbase> <oldbase> <branch>\n```",
			"type":"text",
			"x":4436,
			"y":13461,
			"width":484,
			"height":60
		},
		{
			"id":"b280e56f12ba7c20",
			"styleAttributes":{},
			"text":"reword/r - Изменить сообщение коммита",
			"type":"text",
			"x":5100,
			"y":13378,
			"width":250,
			"height":60
		},
		{
			"id":"1844bb373aade5c8",
			"styleAttributes":{},
			"text":"squash/s - Объединить коммит с предыдущим",
			"type":"text",
			"x":5100,
			"y":13610,
			"width":250,
			"height":60
		},
		{
			"id":"411734b51b4df41e",
			"styleAttributes":{},
			"text":"```git\n<<<<<<< HEAD \nИзменения в текущей ветке \n======= Изменения в ветке, которую мержим \n>>>>>>> имя_ветки\n```",
			"type":"text",
			"x":3100,
			"y":12731,
			"width":429,
			"height":143
		},
		{
			"id":"3ecb15b25dfd2309",
			"styleAttributes":{},
			"text":"Случаи использования",
			"type":"text",
			"x":3961,
			"y":12977,
			"width":250,
			"height":60
		},
		{
			"id":"e95fd07ace6d1608",
			"styleAttributes":{},
			"text":"git rebase",
			"type":"text",
			"x":3628,
			"y":12726,
			"width":250,
			"height":60
		},
		{
			"id":"d1b437b0c1304585",
			"styleAttributes":{},
			"text":"Позволяет переписывать историю коммитов при интеграции изменений",
			"type":"text",
			"x":3960,
			"y":12710,
			"width":250,
			"height":93
		},
		{
			"id":"8da52dba3ea3fb15",
			"styleAttributes":{},
			"text":"```git\ngit checkout feature\ngit rebase main\n```",
			"type":"text",
			"x":4560,
			"y":12966,
			"width":250,
			"height":83
		},
		{
			"id":"1d0a584f090ac836",
			"styleAttributes":{},
			"text":"Вместо создания коммита слияния, rebase переносит коммиты одной ветки на вершину другой, создавая более линейную и чистую историю",
			"type":"text",
			"x":4280,
			"y":12669,
			"width":250,
			"height":176
		},
		{
			"id":"a905c73c16d35534",
			"styleAttributes":{},
			"text":"Конфликты слияния",
			"type":"text",
			"x":2162,
			"y":12956,
			"width":250,
			"height":60
		},
		{
			"id":"4db37f13277dca68",
			"styleAttributes":{},
			"text":"После разрешения конфликтов файл нужно добавить в индекс и сделать коммит",
			"type":"text",
			"x":2800,
			"y":13040,
			"width":250,
			"height":130
		},
		{
			"id":"99751c79c27252ab",
			"styleAttributes":{},
			"text":"Git помечает конфликтные участки в файлах специальными маркерами",
			"type":"text",
			"x":2800,
			"y":12740,
			"width":250,
			"height":124
		},
		{
			"id":"f1e78008f826a78d",
			"styleAttributes":{},
			"text":"Работа с ветками - процесс разработки",
			"type":"text",
			"x":3216,
			"y":11168,
			"width":250,
			"height":60
		},
		{
			"id":"e11b658c767dfa3c",
			"styleAttributes":{},
			"text":"Основная ветка содержит стабильную, готовую к релизу версию проекта",
			"type":"text",
			"x":2936,
			"y":11290,
			"width":250,
			"height":103
		},
		{
			"id":"7ad9a7d16298b3cd",
			"styleAttributes":{},
			"text":"История коммитов становится более линейной и чистой",
			"type":"text",
			"x":5006,
			"y":11289,
			"width":250,
			"height":93
		},
		{
			"id":"35c14d75cc8daa3b",
			"styleAttributes":{},
			"text":"drop/d - Удалить коммит",
			"type":"text",
			"x":5100,
			"y":13838,
			"width":250,
			"height":60
		},
		{
			"id":"f42898a46baed7d6",
			"styleAttributes":{},
			"text":"```git\ngit checkout <branch name>\n```",
			"type":"text",
			"x":6716,
			"y":11100,
			"width":304,
			"height":60
		},
		{
			"id":"03c0b21b7d7abe8e",
			"styleAttributes":{},
			"text":"```git\ngit checkout -b <branch name>\n```",
			"type":"text",
			"x":6716,
			"y":11225,
			"width":328,
			"height":60
		},
		{
			"id":"a60b820eeab69ff4",
			"styleAttributes":{},
			"text":"\"Переносит\" коммиты из одной ветки на вершину другой",
			"type":"text",
			"x":4701,
			"y":11290,
			"width":250,
			"height":90
		},
		{
			"file":"Cache/Pasted image 20250211132712.png",
			"id":"8e5e67766094ad1a",
			"styleAttributes":{},
			"type":"file",
			"x":4600,
			"y":12629,
			"width":400,
			"height":255
		},
		{
			"id":"47c6556b6e3c9fb3",
			"styleAttributes":{},
			"text":"```git\ngit merge <branch name>\n```",
			"type":"text",
			"x":6716,
			"y":11340,
			"width":284,
			"height":60
		},
		{
			"id":"47c00eaab48fc72d",
			"styleAttributes":{},
			"text":"```git\ngit rebase <branch name>\n```",
			"type":"text",
			"x":6716,
			"y":11420,
			"width":284,
			"height":60
		},
		{
			"id":"f2d8d86b96fb91a7",
			"styleAttributes":{},
			"text":"Можно использовать когда необходимо больше контроля над процессом интеграции изменений",
			"type":"text",
			"x":5356,
			"y":9396,
			"width":250,
			"height":134
		},
		{
			"id":"9f41ea50104c1ed0",
			"styleAttributes":{},
			"text":"Можно использовать перед слиянием или --rebase, чтобы посмотреть изменения и принять решение",
			"type":"text",
			"x":5356,
			"y":9546,
			"width":250,
			"height":152
		},
		{
			"id":"3e72ce3223403974",
			"styleAttributes":{},
			"text":"```git\ngit pull <repo name>\n```",
			"type":"text",
			"x":6040,
			"y":9658,
			"width":250,
			"height":60
		},
		{
			"id":"6e5bab8a339b4e02",
			"styleAttributes":{},
			"text":"Как использовать",
			"type":"text",
			"x":5697,
			"y":9396,
			"width":250,
			"height":60
		},
		{
			"id":"226c3b943b1cfe82",
			"styleAttributes":{},
			"text":"```git\ngit branch <branch name>\n```",
			"type":"text",
			"x":6716,
			"y":11020,
			"width":294,
			"height":60
		},
		{
			"id":"ee410801ceac52a5",
			"styleAttributes":{},
			"text":"```git\ngit branch -D <branch name>\n```",
			"type":"text",
			"x":6716,
			"y":11600,
			"width":328,
			"height":60
		},
		{
			"id":"9c1fa8204644e0a0",
			"styleAttributes":{},
			"text":"```git\ngit branch -d <branch name>\n```",
			"type":"text",
			"x":6716,
			"y":11500,
			"width":328,
			"height":60
		},
		{
			"id":"60d946d3a4391ad1",
			"styleAttributes":{},
			"text":"Процесс объединения изменений из одной ветки в другую",
			"type":"text",
			"x":6382,
			"y":10620,
			"width":250,
			"height":103
		},
		{
			"id":"e6d1686ae12e50d6",
			"styleAttributes":{},
			"text":"Является ключевой операцией для интеграции результатов работы, выполненной в отдельных ветки",
			"type":"text",
			"x":6700,
			"y":10597,
			"width":250,
			"height":149
		},
		{
			"id":"6c944fc331d52026",
			"styleAttributes":{},
			"text":"Основные команды для работы с ветками",
			"type":"text",
			"x":6382,
			"y":10948,
			"width":250,
			"height":60
		},
		{
			"id":"d6150da1bf924263",
			"styleAttributes":{},
			"text":"Слияние веток и перебазирование",
			"type":"text",
			"x":3967,
			"y":11167,
			"width":250,
			"height":60
		},
		{
			"id":"f98ae13774184ae7",
			"styleAttributes":{},
			"text":"Слияние (merge)",
			"type":"text",
			"x":4366,
			"y":10998,
			"width":250,
			"height":60
		},
		{
			"id":"15a41468f016ade6",
			"styleAttributes":{},
			"text":"```git\ngit merge <branch name>\n```",
			"type":"text",
			"x":5326,
			"y":10998,
			"width":280,
			"height":60
		},
		{
			"id":"3ed48ae9f8abf298",
			"styleAttributes":{},
			"text":"Ситуация, когда работа над задачей завершена и протестирована, а ветку с изменениями нужно \"слить\" с основной",
			"type":"text",
			"x":3967,
			"y":11306,
			"width":250,
			"height":148
		},
		{
			"id":"2d66e1d3fc3e1b4b",
			"styleAttributes":{},
			"text":"Создаются через \n```git\ngit checkout -b <branch_name>\n```",
			"type":"text",
			"x":3472,
			"y":11454,
			"width":361,
			"height":124
		},
		{
			"id":"7cde4ee55b5e3a19",
			"styleAttributes":{},
			"text":"```git\ngit branch -d <branch name>\n```",
			"type":"text",
			"x":5326,
			"y":11305,
			"width":320,
			"height":60
		},
		{
			"id":"d09fe18ffc60d1de",
			"styleAttributes":{},
			"text":"Смерживание веток",
			"type":"text",
			"x":6040,
			"y":10948,
			"width":250,
			"height":60
		},
		{
			"id":"58df5735e8552829",
			"styleAttributes":{},
			"text":"Создает новый коммит слияния, который объединяет изменения из двух веток.",
			"type":"text",
			"x":4694,
			"y":10963,
			"width":250,
			"height":130
		},
		{
			"id":"f4132823a4f39c04",
			"styleAttributes":{},
			"text":"История коммитов становится более разветвленной",
			"type":"text",
			"x":5006,
			"y":10978,
			"width":250,
			"height":100
		},
		{
			"id":"0ca0eeb7f3a1dc1e",
			"styleAttributes":{},
			"text":"Используется ",
			"type":"text",
			"x":5376,
			"y":9732,
			"width":250,
			"height":60
		},
		{
			"id":"1c3766e21f7ca273",
			"styleAttributes":{},
			"text":"Обычно используется origin, т.к. является именем удаленного репозитория по умолчанию",
			"type":"text",
			"x":4206,
			"y":9550,
			"width":250,
			"height":147
		},
		{
			"id":"cc9d58c584c9d522",
			"styleAttributes":{},
			"text":"Скачивает изменения только из указанного удаленного репозитория",
			"type":"text",
			"x":3866,
			"y":9573,
			"width":250,
			"height":100
		},
		{
			"id":"05515d24696d37bf",
			"styleAttributes":{},
			"text":"Когда использовать",
			"type":"text",
			"x":2639,
			"y":9517,
			"width":250,
			"height":60
		},
		{
			"id":"800f5921377a5db5",
			"styleAttributes":{},
			"text":"Скачивает изменения только из указанной ветки указанного удаленного репозитория",
			"type":"text",
			"x":3866,
			"y":9722,
			"width":250,
			"height":121
		},
		{
			"id":"5b9b56ed1fc71be9",
			"styleAttributes":{},
			"text":"Перебазирование (rebase)",
			"type":"text",
			"x":4366,
			"y":11305,
			"width":250,
			"height":60
		},
		{
			"id":"1a9c856abf68059f",
			"styleAttributes":{},
			"text":"Разработчик вносит изменения и коммитит их в своей ветке, эти коммиты не влияют на основную и на ветки других разработчиков",
			"type":"text",
			"x":3216,
			"y":11738,
			"width":250,
			"height":187
		},
		{
			"id":"046f230a5667f021",
			"styleAttributes":{},
			"text":"Разработка в отдельной ветке",
			"type":"text",
			"x":3216,
			"y":11598,
			"width":250,
			"height":60
		},
		{
			"id":"aaaa3d5d6696e0be",
			"styleAttributes":{},
			"text":"Ветки для задач",
			"type":"text",
			"x":3527,
			"y":11311,
			"width":250,
			"height":60
		},
		{
			"id":"d63f6fb12ff923ad",
			"styleAttributes":{},
			"text":"Историю коммитов можно представить как цепочку, где каждый коммит - звено. Ветка указывает она одно из этих звеньев, обозначая текущую \"версию\" проекта",
			"type":"text",
			"x":2276,
			"y":11609,
			"width":250,
			"height":249
		},
		{
			"id":"fbeb0c7ca7e3cb68",
			"styleAttributes":{},
			"text":"Ветка (branch)",
			"type":"text",
			"x":1951,
			"y":11168,
			"width":250,
			"height":60
		},
		{
			"id":"7bc2a8e84fe022c4",
			"styleAttributes":{},
			"text":"Является \"указателем\" на определенный коммит",
			"type":"text",
			"x":2276,
			"y":11168,
			"width":250,
			"height":60
		},
		{
			"id":"19d6eb8dee064d90",
			"styleAttributes":{},
			"text":"Ветки позволяют вести разработку параллельно, не затрагивая основную версию проекта",
			"type":"text",
			"x":2648,
			"y":11341,
			"width":250,
			"height":117
		},
		{
			"file":"Cache/Pasted image 20250211102902.png",
			"id":"d0891719de558c19",
			"styleAttributes":{},
			"type":"file",
			"x":2201,
			"y":11335,
			"width":400,
			"height":205
		},
		{
			"id":"d5112f70327c0d64",
			"styleAttributes":{},
			"text":"```git\ngit fetch <repo_name> <branch name>\n```",
			"type":"text",
			"x":3427,
			"y":9752,
			"width":379,
			"height":60
		},
		{
			"id":"836032a54275aa0a",
			"styleAttributes":{},
			"text":"Просмотреть новые коммиты",
			"type":"text",
			"x":3348,
			"y":9933,
			"width":250,
			"height":60
		},
		{
			"id":"f5e3f2169c66a3ed",
			"styleAttributes":{},
			"text":"Сравнить изменения с локальной веткой",
			"type":"text",
			"x":3348,
			"y":10088,
			"width":250,
			"height":60
		},
		{
			"id":"125f022ab5f2edc0",
			"styleAttributes":{},
			"text":"Перебазировать локальную ветку на удаленную",
			"type":"text",
			"x":3348,
			"y":10382,
			"width":250,
			"height":100
		},
		{
			"id":"e93ed9a63568eddc",
			"styleAttributes":{},
			"text":"Слить изменения с локальной веткой",
			"type":"text",
			"x":3348,
			"y":10242,
			"width":250,
			"height":60
		},
		{
			"id":"a9993686e72bb641",
			"styleAttributes":{},
			"text":"Зачем нужны",
			"type":"text",
			"x":2646,
			"y":11168,
			"width":250,
			"height":60
		},
		{
			"id":"89199c31f52fdb40",
			"styleAttributes":{},
			"text":"Скачивает изменения из всех удаленных репозиториев, настроенных для локального репозитория пользователя",
			"type":"text",
			"x":3866,
			"y":9347,
			"width":250,
			"height":184
		},
		{
			"id":"1d9c7dc861dc7208",
			"styleAttributes":{},
			"text":"```git\ngit fetch\n```",
			"type":"text",
			"x":3430,
			"y":9409,
			"width":250,
			"height":60
		},
		{
			"id":"3d1e6b04f15f6c03",
			"styleAttributes":{},
			"text":"Не изменяет текущую рабочую ветку",
			"type":"text",
			"x":3430,
			"y":9082,
			"width":250,
			"height":60
		},
		{
			"id":"7c010c376aa53643",
			"styleAttributes":{},
			"text":"Использование git fetch",
			"type":"text",
			"x":3035,
			"y":9410,
			"width":250,
			"height":60
		},
		{
			"id":"49ed5234261972d9",
			"styleAttributes":{},
			"text":"Скачивает новые коммиты",
			"type":"text",
			"x":3430,
			"y":8725,
			"width":250,
			"height":60
		},
		{
			"id":"f9a24a66a262aec9",
			"styleAttributes":{},
			"text":"```git\ngit fetch <repo_name>\n```",
			"type":"text",
			"x":3430,
			"y":9593,
			"width":276,
			"height":60
		},
		{
			"id":"b252def2aaff912d",
			"styleAttributes":{},
			"text":"Использовать git rebase origin/main для перебазироваться локальной ветки на удаленную",
			"type":"text",
			"x":3652,
			"y":10353,
			"width":250,
			"height":157
		},
		{
			"id":"d5c4187bc8356ea6",
			"styleAttributes":{},
			"text":"Использовать git merge origin/main для слияния изменений из удаленной ветки в текущую",
			"type":"text",
			"x":3652,
			"y":10213,
			"width":250,
			"height":119
		},
		{
			"id":"3341324e1f64d1f6",
			"styleAttributes":{},
			"text":"Использовать git log origin/main для просмотра истории коммитов в удаленной ветке",
			"type":"text",
			"x":3652,
			"y":9897,
			"width":250,
			"height":133
		},
		{
			"id":"8d81c96606f273d3",
			"styleAttributes":{},
			"text":"Использовать git diff main origin/main для просмотра различий между локальной веткой и удаленной",
			"type":"text",
			"x":3652,
			"y":10041,
			"width":250,
			"height":153
		},
		{
			"id":"482e9acdc0f4997b",
			"styleAttributes":{},
			"text":"```git\ngit remote rename <старое_имя> <новое_имя>\n```",
			"type":"text",
			"x":411,
			"y":9117,
			"width":444,
			"height":60
		},
		{
			"id":"a7a5ad37f7348ad0",
			"styleAttributes":{},
			"text":"```git\ngit remote set-url <name> <new_url>\n```",
			"type":"text",
			"x":411,
			"y":9340,
			"width":375,
			"height":60
		},
		{
			"id":"702845d5507e2586",
			"styleAttributes":{},
			"text":"\\<URL>",
			"type":"text",
			"x":1267,
			"y":9100,
			"width":250,
			"height":60
		},
		{
			"id":"d08faa7ec2120a91",
			"styleAttributes":{},
			"text":"Изменение URL существующего репозитория",
			"type":"text",
			"x":920,
			"y":9320,
			"width":250,
			"height":100
		},
		{
			"id":"c0fb5701a9d01990",
			"styleAttributes":{},
			"text":"Подключаться к удаленным репозиториям",
			"type":"text",
			"x":-170,
			"y":8923,
			"width":250,
			"height":60
		},
		{
			"id":"8e735646103cd309",
			"styleAttributes":{},
			"text":"```git\ngit remote remove <name> \ngit remote rm <name>\n```",
			"type":"text",
			"x":411,
			"y":9220,
			"width":285,
			"height":87
		},
		{
			"id":"f0f488bbf7967f50",
			"styleAttributes":{},
			"text":"Является фундаментальной для работы с репозиториями, т.к.",
			"type":"text",
			"x":-560,
			"y":8979,
			"width":250,
			"height":130
		},
		{
			"id":"36071ce94dc17d15",
			"styleAttributes":{},
			"text":"Переименование существующего нового репозитория",
			"type":"text",
			"x":920,
			"y":9100,
			"width":250,
			"height":94
		},
		{
			"id":"ff976373d6d5de09",
			"styleAttributes":{},
			"text":"Удаление удаленного репозитория",
			"type":"text",
			"x":920,
			"y":9234,
			"width":250,
			"height":60
		},
		{
			"id":"b5ad37372b58d9b6",
			"styleAttributes":{},
			"text":"Полезно, если URL изменился",
			"type":"text",
			"x":1267,
			"y":9340,
			"width":250,
			"height":60
		},
		{
			"id":"b77c1dad8ee04a8a",
			"styleAttributes":{},
			"text":"```git\ngit remote -v\ngit remote --verbose\n```",
			"type":"text",
			"x":411,
			"y":8860,
			"width":250,
			"height":100
		},
		{
			"id":"3a475452549ce596",
			"styleAttributes":{},
			"text":"```git\ngit remote add <name> <URL>\n```",
			"type":"text",
			"x":411,
			"y":9000,
			"width":309,
			"height":60
		},
		{
			"id":"11181445410fb4e0",
			"styleAttributes":{},
			"text":"Команда выводит список удаленных репозиториев вместе с URL-адресами",
			"type":"text",
			"x":920,
			"y":8860,
			"width":250,
			"height":100
		},
		{
			"id":"bc24a228b78cfaa4",
			"styleAttributes":{},
			"text":"\\<name>",
			"type":"text",
			"x":1267,
			"y":8947,
			"width":250,
			"height":60
		},
		{
			"id":"89e1ccbd6d1d3f98",
			"styleAttributes":{},
			"text":"Обновлять информацию об удаленных репозиториях",
			"type":"text",
			"x":-170,
			"y":9100,
			"width":250,
			"height":87
		},
		{
			"id":"5b53ed6706ee72f8",
			"styleAttributes":{},
			"text":"Управлять списком подключенных репозиториев",
			"type":"text",
			"x":-170,
			"y":8996,
			"width":250,
			"height":95
		},
		{
			"id":"eb140b6ccb165408",
			"styleAttributes":{},
			"text":"Используется для управления списком удаленных репозиториев, с которыми связан локальный репозиторий",
			"type":"text",
			"x":-240,
			"y":8678,
			"width":250,
			"height":178
		},
		{
			"id":"313b31a6b38192f9",
			"styleAttributes":{},
			"text":"git remote",
			"type":"text",
			"x":-571,
			"y":8725,
			"width":250,
			"height":60
		},
		{
			"id":"4a8c39da9d17624c",
			"styleAttributes":{},
			"text":"Команда выводит список уже настроенных удаленных репозиториев для вашего локального репозитория",
			"type":"text",
			"x":920,
			"y":8679,
			"width":250,
			"height":155
		}
	]
}