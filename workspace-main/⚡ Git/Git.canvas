		},
		{
			"id":"023d2596275a7e8f",
			"styleAttributes":{},
			"type":"group",
			"x":6720,
			"y":7819,
			"width":900,
			"height":263,
			"label":"18.1 reset vs revert vs checkout"
		},
		{
			"id":"64b31e66c738a37d",
			"styleAttributes":{},
			"type":"group",
			"x":2068,
			"y":8658,
			"width":2408,
			"height":1872,
			"label":"20. Git fetch"
		},
		{
			"id":"146c50d3d16bc00b",
			"styleAttributes":{},
			"text":"Fetch не вносит никаких изменений в текущую рабочую ветку. Можно просмотреть скачанные изменения, прежде чем решить, как их интегрировать",
			"type":"text",
			"x":3866,
			"y":9004,
			"width":250,
			"height":217
		},
		{
			"id":"a4ebce2dbb3a8ec5",
			"styleAttributes":{},
			"text":"Короткое имя, которое будет использоваться для ссылки на этот репозиторий",
			"type":"text",
			"x":1620,
			"y":8915,
			"width":250,
			"height":124
		},
		{
			"id":"245bfd4c6eb5bd3a",
			"styleAttributes":{},
			"text":"Позволяет загрузить изменения из удаленного репозитория в свой локальный",
			"type":"text",
			"x":2406,
			"y":8864,
			"width":250,
			"height":120
		},
		{
			"id":"bd9de585ad22ecd7",
			"styleAttributes":{},
			"text":"Fetch не сливает эти изменения автоматически с текущей рабочей веткой. Он лишь скачивает и сохраняет их в локальном репозитории в виде удаленных веток",
			"type":"text",
			"x":2706,
			"y":8815,
			"width":250,
			"height":218
		},
		{
			"id":"10005244b5f42050",
			"styleAttributes":{},
			"text":"Функциональность Fetch",
			"type":"text",
			"x":3038,
			"y":8893,
			"width":250,
			"height":60
		},
		{
			"id":"5b794dfa6e06e7ef",
			"styleAttributes":{},
			"text":"Git fetch - скачивает изменения, но не сливает их",
			"type":"text",
			"x":2406,
			"y":9186,
			"width":250,
			"height":97
		},
		{
			"id":"8852034709f60818",
			"styleAttributes":{},
			"text":"Git pull - скачивает изменения и автоматически сливает их с текущей веткой",
			"type":"text",
			"x":2406,
			"y":9303,
			"width":250,
			"height":120
		},
		{
			"id":"24acabb01881d02c",
			"styleAttributes":{},
			"text":"Git fetch",
			"type":"text",
			"x":2088,
			"y":8894,
			"width":250,
			"height":60
		},
		{
			"id":"4be287f782208e10",
			"styleAttributes":{},
			"text":"git fetch vs git pull",
			"type":"text",
			"x":2088,
			"y":9204,
			"width":250,
			"height":60
		},
		{
			"id":"0d62a4a6a5c24043",
			"styleAttributes":{},
			"text":"```git\ngit remote \n```",
			"type":"text",
			"x":411,
			"y":8726,
			"width":250,
			"height":60
		},
		{
			"id":"8442d8bcf96bc46a",
			"styleAttributes":{},
			"text":"URL удаленного репозитория, который может быть как SSH URL, так и HTTPS URL",
			"type":"text",
			"x":1620,
			"y":9070,
			"width":250,
			"height":120
		},
		{
			"id":"9be7320413e489ab",
			"styleAttributes":{},
			"text":"Варианты использования",
			"type":"text",
			"x":80,
			"y":8726,
			"width":250,
			"height":60
		},
		{
			"id":"3e837ebcd2e284f1",
			"styleAttributes":{},
			"text":"Обновляет удаленные ветки",
			"type":"text",
			"x":3430,
			"y":8894,
			"width":250,
			"height":60
		},
		{
			"id":"d6c07c99232ea359",
			"styleAttributes":{},
			"text":"Команда добавляет новый удаленный репозиторий",
			"type":"text",
			"x":920,
			"y":8989,
			"width":250,
			"height":82
		},
		{
			"id":"c64ef4b1abdc2142",
			"styleAttributes":{},
			"text":"Когда нужно посмотреть, какие изменения произошли в удаленном репозитории, не изменяя свою локальную работу",
			"type":"text",
			"x":2213,
			"y":9470,
			"width":250,
			"height":157
		},
		{
			"id":"61c0cc5ed5f37463",
			"styleAttributes":{},
			"text":"Перед выполнением git merge/git rebase, чтобы посмотреть изменения и принять решение о способе их интеграции",
			"type":"text",
			"x":2213,
			"y":9673,
			"width":250,
			"height":140
		},
		{
			"id":"c591819bfd610b75",
			"styleAttributes":{},
			"text":"Когда нужно обновить локальные копии удаленных веток",
			"type":"text",
			"x":2213,
			"y":9833,
			"width":250,
			"height":100
		},
		{
			"id":"bd52d2fa4ccfe066",
			"styleAttributes":{},
			"text":"Возможности после выполнения",
			"type":"text",
			"x":3035,
			"y":9933,
			"width":250,
			"height":60
		},
		{
			"id":"6ffcadb6f7c1955d",
			"styleAttributes":{},
			"text":"Показывает коммиты, созданные после указанной даты",
			"type":"text",
			"x":2799,
			"y":5380,
			"width":250,
			"height":90
		},
		{
			"id":"5d03c92910fe1a37",
			"styleAttributes":{},
			"text":"Показывает коммиты, созданные до указанной даты",
			"type":"text",
			"x":2799,
			"y":5478,
			"width":250,
			"height":92
		},
		{
			"id":"d63db6bf0d78d61a",
			"styleAttributes":{},
			"text":"Позволяет настроить формат вывода",
			"type":"text",
			"x":2799,
			"y":5302,
			"width":250,
			"height":60
		},
		{
			"id":"dfb647e88b5557ec",
			"styleAttributes":{},
			"text":"```git\ncommit <hash> \nAuthor: <author name> <author email> \nDate: <date> \n\n\t<commit message>\n```",
			"type":"text",
			"x":2520,
			"y":5046,
			"width":374,
			"height":173
		},
		{
			"id":"7c2d787b2de7e5ab",
			"styleAttributes":{},
			"text":"--pretty=%format%",
			"type":"text",
			"x":2497,
			"y":5302,
			"width":250,
			"height":60
		},
		{
			"id":"83dac073fe91e6c4",
			"styleAttributes":{},
			"text":"--since=%date",
			"type":"text",
			"x":2497,
			"y":5395,
			"width":250,
			"height":60
		},
		{
			"id":"739117d6704c5577",
			"styleAttributes":{},
			"text":"```git\ngit log --oneline\n```",
			"type":"text",
			"x":2831,
			"y":4464,
			"width":250,
			"height":60
		},
		{
			"id":"d14bbfda769b6e68",
			"styleAttributes":{},
			"text":"--until=%date%",
			"type":"text",
			"x":2497,
			"y":5494,
			"width":250,
			"height":60
		},
		{
			"id":"375598421a741f0b",
			"styleAttributes":{},
			"text":"Формат вывода",
			"type":"text",
			"x":2192,
			"y":5103,
			"width":250,
			"height":60
		},
		{
			"id":"55eeaa332e401898",
			"styleAttributes":{},
			"text":"Дополнительные аргументы",
			"type":"text",
			"x":2192,
			"y":5300,
			"width":250,
			"height":60
		},
		{
			"id":"c73152fbc55447ee",
			"styleAttributes":{},
			"text":"Показывает коммиты с указанным автором",
			"type":"text",
			"x":3224,
			"y":4680,
			"width":250,
			"height":60
		},
		{
			"id":"a4cbdfebb3e6466e",
			"styleAttributes":{},
			"text":"Хранит изменения локально, не отправляет изменения на удаленный репозиторий",
			"type":"text",
			"x":4214,
			"y":4424,
			"width":250,
			"height":122
		},
		{
			"id":"dc00aeb97852dc9f",
			"styleAttributes":{},
			"text":"git stash",
			"type":"text",
			"x":4215,
			"y":4264,
			"width":250,
			"height":60
		},
		{
			"file":"Cache/Pasted image 20250209010935.png",
			"id":"6e0c1e0b9063e05b",
			"styleAttributes":{},
			"type":"file",
			"x":3560,
			"y":4517,
			"width":399,
			"height":188
		},
		{
			"id":"794693618467f48a",
			"styleAttributes":{},
			"text":"Визуализация истории ветвления и слияния",
			"type":"text",
			"x":3635,
			"y":4774,
			"width":250,
			"height":60
		},
		{
			"id":"e36aaadef56a03d2",
			"styleAttributes":{},
			"text":"```git\ngit log --grep=\"keyword\"\n```",
			"type":"text",
			"x":2831,
			"y":4774,
			"width":309,
			"height":60
		},
		{
			"id":"ece5441826a66c6d",
			"styleAttributes":{},
			"text":"```git\ngit log -n %number%\n```",
			"type":"text",
			"x":2831,
			"y":4879,
			"width":250,
			"height":60
		},
		{
			"id":"381fc0ba725a8a9e",
			"styleAttributes":{},
			"text":"```git\ngit log --author=\"Author\"\n```",
			"type":"text",
			"x":2831,
			"y":4680,
			"width":309,
			"height":60
		},
		{
			"id":"3f23d8749c6061b5",
			"styleAttributes":{},
			"text":"```git\ngit log --graph\n```",
			"type":"text",
			"x":2831,
			"y":4581,
			"width":250,
			"height":60
		},
		{
			"id":"ac01e9e5453228c0",
			"styleAttributes":{},
			"text":"```git\ngit log %file%\n```",
			"type":"text",
			"x":2831,
			"y":4976,
			"width":250,
			"height":60
		},
		{
			"id":"7ee55718c6e26c77",
			"styleAttributes":{},
			"text":"Когда использовать",
			"type":"text",
			"x":4520,
			"y":5006,
			"width":250,
			"height":60
		},
		{
			"id":"d66963e6c52174e0",
			"styleAttributes":{},
			"text":"Показывает историю изменений файла",
			"type":"text",
			"x":3224,
			"y":4976,
			"width":250,
			"height":60
		},
		{
			"id":"45a408b143e4070b",
			"styleAttributes":{},
			"text":"Показывает указанное количество последних комимитов",
			"type":"text",
			"x":3224,
			"y":4860,
			"width":250,
			"height":99
		},
		{
			"id":"11186f2a8fcc6356",
			"styleAttributes":{},
			"text":"Показывает коммиты, в описании которых есть ключевое слово",
			"type":"text",
			"x":3224,
			"y":4755,
			"width":250,
			"height":98
		},
		{
			"id":"f56dd248d41d2c56",
			"styleAttributes":{},
			"text":"Вывод каждого коммита в одну строку, показывая хэш и описание",
			"type":"text",
			"x":3224,
			"y":4450,
			"width":250,
			"height":88
		},
		{
			"id":"e57f77bd618c6c08",
			"styleAttributes":{},
			"text":"Вывод полной истории коммитов в хронологическом порядке",
			"type":"text",
			"x":3224,
			"y":4227,
			"width":250,
			"height":97
		},
		{
			"id":"2166f62b93896e14",
			"styleAttributes":{},
			"text":"Отображение изменений, внесенных в каждом коммите",
			"type":"text",
			"x":3224,
			"y":4339,
			"width":250,
			"height":98
		},
		{
			"id":"971cac5b8a2dff90",
			"styleAttributes":{},
			"text":"Отображение истории коммитов в виде графа, показывая ветвления и слияния",
			"type":"text",
			"x":3224,
			"y":4549,
			"width":250,
			"height":123
		},
		{
			"id":"8731df90c76803ee",
			"styleAttributes":{},
			"text":"Метод временного сохранения изменений, которые еще не готовы для коммита",
			"type":"text",
			"x":4520,
			"y":4235,
			"width":250,
			"height":119
		},
		{
			"id":"1fbc6c4138a5f38d",
			"styleAttributes":{},
			"text":"Берет текущие изменения и временно откладывает их в \"тайник\", после этого рабочий каталог возвращает к состоянию последнего коммита",
			"type":"text",
			"x":4840,
			"y":4207,
			"width":250,
			"height":174
		},
		{
			"id":"a287d520b8e98c85",
			"styleAttributes":{},
			"text":"Когда нужно переключиться на другую ветку для исправления бага, но текущие изменения еще не готовы к коммиту",
			"type":"text",
			"x":4840,
			"y":4950,
			"width":250,
			"height":173
		},
		{
			"id":"484282e89dccc356",
			"styleAttributes":{},
			"text":"Когда нужно поэкспериментировать с кодом, не боясь потерять текущие изменения",
			"type":"text",
			"x":4840,
			"y":5140,
			"width":250,
			"height":120
		},
		{
			"id":"8e267be058289ab4",
			"styleAttributes":{},
			"text":"С помощью команды git add добавляются нужные изменения в индекс (staging area)",
			"type":"text",
			"x":748,
			"y":4920,
			"width":250,
			"height":126
		},
		{
			"id":"7353968eae2f7716",
			"styleAttributes":{},
			"text":"Должно быть информативным и понятным, чтобы другие люди могли легко понять, какие изменения были сделаны",
			"type":"text",
			"x":60,
			"y":5280,
			"width":250,
			"height":182
		},
		{
			"id":"00a277b76df27e23",
			"styleAttributes":{},
			"text":"Использовать краткие и понятные фразы",
			"type":"text",
			"x":736,
			"y":5341,
			"width":250,
			"height":60
		},
		{
			"id":"9db6cca6011938d6",
			"styleAttributes":{},
			"text":"```git\ngit log -p\n```",
			"type":"text",
			"x":2831,
			"y":4358,
			"width":250,
			"height":60
		},
		{
			"id":"adc7b55d850e4db7",
			"styleAttributes":{},
			"text":"Показывает список коммитов, отсортированных по времени создания, начиная с самых последних",
			"type":"text",
			"x":2200,
			"y":4190,
			"width":250,
			"height":171
		},
		{
			"id":"7a9b6dc3030ee9a8",
			"styleAttributes":{},
			"text":"Основные варианты использования",
			"type":"text",
			"x":2500,
			"y":4245,
			"width":250,
			"height":60
		},
		{
			"id":"5a3e1f0d7d3199a7",
			"styleAttributes":{},
			"text":"```git\ngit log\n```",
			"type":"text",
			"x":2831,
			"y":4245,
			"width":250,
			"height":60
		},
		{
			"id":"cf738a58d85ad4e7",
			"styleAttributes":{},
			"text":"Когда нужно временно отложить изменения, чтобы потом вернуться к ним",
			"type":"text",
			"x":4840,
			"y":5280,
			"width":250,
			"height":119
		},
		{
			"id":"92150218a94fae4c",
			"styleAttributes":{},
			"text":"Если не были добавлены изменения в индекс, то они не попадут в коммит",
			"type":"text",
			"x":60,
			"y":4672,
			"width":250,
			"height":101
		},
		{
			"id":"ca60290985ccb511",
			"styleAttributes":{},
			"text":"Описывать суть изменений, а не детали реализации",
			"type":"text",
			"x":736,
			"y":5409,
			"width":250,
			"height":106
		},
		{
			"id":"981d6f604f5ba48b",
			"styleAttributes":{},
			"text":"Как работает",
			"type":"text",
			"x":380,
			"y":4800,
			"width":250,
			"height":60
		},
		{
			"id":"d63365babf96997e",
			"styleAttributes":{},
			"text":"```git\ngit commit\n```",
			"type":"text",
			"x":700,
			"y":4236,
			"width":250,
			"height":60
		},
		{
			"id":"045b655de4589a8b",
			"styleAttributes":{},
			"text":"Команда git commit создает новый коммит, который содержит изменения, которые находятся в индексе",
			"type":"text",
			"x":748,
			"y":5080,
			"width":250,
			"height":143
		},
		{
			"id":"8c394d90357f7478",
			"styleAttributes":{},
			"text":"Рекомендации",
			"type":"text",
			"x":380,
			"y":5341,
			"width":250,
			"height":60
		},
		{
			"id":"4c283c0e3d752f8b",
			"styleAttributes":{},
			"text":"```git\ngit commit -m \"сообщение коммита\"\n```",
			"type":"text",
			"x":700,
			"y":4342,
			"width":345,
			"height":60
		},
		{
			"id":"d1da705fd3e850f9",
			"styleAttributes":{},
			"text":"Краткое описание изменений, которые были внесены в данном коммите",
			"type":"text",
			"x":-240,
			"y":5306,
			"width":250,
			"height":129
		},
		{
			"id":"b37b6f2890e1dd21",
			"styleAttributes":{},
			"text":"```git\ngit commit -a -m \"Сообщение коммита\"\n```",
			"type":"text",
			"x":700,
			"y":4448,
			"width":380,
			"height":60
		},
		{
			"id":"bcbc27e17fc7c837",
			"styleAttributes":{},
			"text":"До 50 символов в длину",
			"type":"text",
			"x":736,
			"y":5540,
			"width":250,
			"height":60
		},
		{
			"id":"b4dd0b77151944ab",
			"styleAttributes":{},
			"text":"Открывает текстовый редактор, в котором возможно ввести сообщение для коммита",
			"type":"text",
			"x":1123,
			"y":4204,
			"width":250,
			"height":123
		},
		{
			"file":"Cache/Pasted image 20250208161300.png",
			"id":"bbc495ab4abab58d",
			"styleAttributes":{},
			"type":"file",
			"x":1045,
			"y":4860,
			"width":680,
			"height":340
		},
		{
			"id":"95d01f19f9be87b6",
			"styleAttributes":{},
			"text":"Запускает интерактивный режим, в котором можно самостоятельно выбрать, какие именно изменения в каждом файле включить в коммит",
			"type":"text",
			"x":1123,
			"y":4549,
			"width":250,
			"height":185
		},
		{
			"id":"0fbae5e79fd1bad0",
			"styleAttributes":{},
			"text":"```git\ngit commit -p\n```",
			"type":"text",
			"x":700,
			"y":4612,
			"width":250,
			"height":60
		},
		{
			"id":"382eb5a5c150308d",
			"styleAttributes":{},
			"text":"Пользователь вносит изменения в файлы в своем рабочем каталоге",
			"type":"text",
			"x":748,
			"y":4784,
			"width":250,
			"height":93
		},
		{
			"id":"45fe82bee68c30cd",
			"styleAttributes":{},
			"text":"Создает коммит с указанным сообщением",
			"type":"text",
			"x":1123,
			"y":4342,
			"width":250,
			"height":60
		},
		{
			"id":"0948d0bcafe093b5",
			"styleAttributes":{},
			"text":"Автоматически добавляет все изменения в индекс, а также создает коммит с указанным сообщением",
			"type":"text",
			"x":1123,
			"y":4418,
			"width":250,
			"height":120
		},
		{
			"id":"0309df2f983fb84e",
			"styleAttributes":{},
			"text":"Действие создает новый коммит, который представляет собой снимок текущего состояния проекта",
			"type":"text",
			"x":60,
			"y":4195,
			"width":250,
			"height":141
		},
		{
			"id":"41bfef0592c71b77",
			"styleAttributes":{},
			"text":"git log",
			"type":"text",
			"x":1883,
			"y":4245,
			"width":250,
			"height":60
		},
		{
			"id":"f27744106ae1d1dd",
			"styleAttributes":{},
			"text":"Unmodifed - не изменен",
			"type":"text",
			"x":1026,
			"y":2411,
			"width":250,
			"height":60
		},
		{
			"id":"b1a92354a0db570c",
			"styleAttributes":{},
			"text":"File type changed - изменен тип файла",
			"type":"text",
			"x":1026,
			"y":2560,
			"width":250,
			"height":60
		},
		{
			"id":"2eeedad4871e4f17",
			"styleAttributes":{},
			"text":"Modified - изменен",
			"type":"text",
			"x":1026,
			"y":2485,
			"width":250,
			"height":60
		},
		{
			"id":"789a875873d0a5b9",
			"styleAttributes":{},
			"text":"Added - добавлен",
			"type":"text",
			"x":1026,
			"y":2640,
			"width":250,
			"height":60
		},
		{
			"id":"26187dfb590d1e66",
			"styleAttributes":{},
			"text":"Возможности",
			"type":"text",
			"x":380,
			"y":4236,
			"width":250,
			"height":60
		},
		{
			"id":"c71ea8a27816b892",
			"styleAttributes":{},
			"text":"Команда создает новый коммит только в том случае, если в индексе есть изменения",
			"type":"text",
			"x":60,
			"y":4500,
			"width":250,
			"height":137
		},
		{
			"id":"60519d81f05c2a42",
			"styleAttributes":{},
			"text":"Важные моменты",
			"type":"text",
			"x":-240,
			"y":4538,
			"width":250,
			"height":60
		},
		{
			"id":"bde3f6c4a5fa3c14",
			"styleAttributes":{},
			"text":"Используется для сохранений изменений в репозитории",
			"type":"text",
			"x":-240,
			"y":4218,
			"width":250,
			"height":96
		},
		{
			"id":"a3e72d7166f3bfde",
			"styleAttributes":{},
			"text":"git commit",
			"type":"text",
			"x":-543,
			"y":4236,
			"width":250,
			"height":60
		},
		{
			"id":"e23b552b43d55292",
			"styleAttributes":{},
			"text":"Сообщение коммита",
			"type":"text",
			"x":-543,
			"y":5341,
			"width":250,
			"height":60
		},
		{
			"id":"bf84e480c0b5834d",
			"styleAttributes":{},
			"text":"T",
			"type":"text",
			"x":720,
			"y":2560,
			"width":250,
			"height":60
		},
		{
			"id":"7b63c3844c8a0969",
			"styleAttributes":{},
			"text":"A",
			"type":"text",
			"x":720,
			"y":2640,
			"width":250,
			"height":60
		},
		{
			"id":"7fc226ff2bad317d",
			"styleAttributes":{},
			"text":"M",
			"type":"text",
			"x":720,
			"y":2485,
			"width":250,
			"height":60
		},
		{
			"id":"d5e08a246aec024e",
			"styleAttributes":{},
			"text":"Нет буквы",
			"type":"text",
			"x":720,
			"y":2411,
			"width":250,
			"height":60
		},
		{
			"id":"b277c76672903782",
			"styleAttributes":{},
			"text":"R",
			"type":"text",
			"x":720,
			"y":2800,
			"width":250,
			"height":60
		},
		{
			"id":"e2aa6d49cbb70015",
			"styleAttributes":{},
			"text":"D",
			"type":"text",
			"x":720,
			"y":2720,
			"width":250,
			"height":60
		},
		{
			"id":"ac166f0a1ba60531",
			"styleAttributes":{},
			"text":"Загрузка существующего проекта",
			"type":"text",
			"x":1380,
			"y":1239,
			"width":250,
			"height":60
		},
		{
			"id":"be390c7696091a8f",
			"styleAttributes":{},
			"text":"Можно использовать IDE, либо же Git Bash",
			"type":"text",
			"x":1680,
			"y":1239,
			"width":250,
			"height":60
		},
		{
			"id":"e31407632f85bd4c",
			"styleAttributes":{},
			"text":"Необязательное поле, обозначает описание репозитория. Поможет другим пользователям понять, для чего он",
			"type":"text",
			"x":665,
			"y":1338,
			"width":250,
			"height":159
		},
		{
			"id":"3a89ea2bdcef1cfc",
			"styleAttributes":{},
			"text":"Репозиторий будет доступен абсолютно всем",
			"type":"text",
			"x":985,
			"y":1558,
			"width":250,
			"height":60
		},
		{
			"id":"6ecf55f009453c91",
			"styleAttributes":{},
			"text":"```\ngit fetch\n```",
			"type":"text",
			"x":3880,
			"y":3311,
			"width":250,
			"height":60
		},
		{
			"id":"b308263436444e75",
			"styleAttributes":{},
			"text":"```\ngit pull\n```",
			"type":"text",
			"x":3880,
			"y":3202,
			"width":250,
			"height":60
		},
		{
			"id":"bf8e98bd9b2a4a83",
			"styleAttributes":{},
			"text":"```\ngit diff\n```",
			"type":"text",
			"x":3880,
			"y":3522,
			"width":250,
			"height":60
		},
		{
			"id":"37b024da82d99d9a",
			"styleAttributes":{},
			"text":"Отправка изменений на удаленный репозиторий",
			"type":"text",
			"x":4309,
			"y":3122,
			"width":250,
			"height":60
		},
		{
			"id":"fe0c30caad012e2d",
			"styleAttributes":{},
			"text":"Обязательное поле, означает наименование репозитория",
			"type":"text",
			"x":665,
			"y":1220,
			"width":250,
			"height":99
		},
		{
			"id":"6ac54323ac40c97d",
			"styleAttributes":{},
			"text":"Public",
			"type":"text",
			"x":665,
			"y":1558,
			"width":250,
			"height":60
		},
		{
			"id":"551bbcf2f7eafc06",
			"styleAttributes":{},
			"text":"Например: файлы сборки, временные файлы, доступы и пр.",
			"type":"text",
			"x":985,
			"y":2047,
			"width":250,
			"height":92
		},
		{
			"id":"6cb9cd1e3698bfca",
			"styleAttributes":{},
			"text":"Репозиторий будет доступен только создателю, а также тем, кто есть в списке \"collaborators\"",
			"type":"text",
			"x":985,
			"y":1638,
			"width":250,
			"height":160
		},
		{
			"id":"de9d72b7b2f566ca",
			"styleAttributes":{},
			"text":"Description",
			"type":"text",
			"x":367,
			"y":1387,
			"width":250,
			"height":60
		},
		{
			"id":"35892e204732b235",
			"styleAttributes":{},
			"text":"Repository name",
			"type":"text",
			"x":367,
			"y":1239,
			"width":250,
			"height":60
		},
		{
			"id":"3a2ae1c8f39bc2c1",
			"styleAttributes":{},
			"text":"При выполнении коммита (git commit), Git создает \"снимок\" состояния проекта, основываясь на содержимом индекса",
			"type":"text",
			"x":2852,
			"y":3217,
			"width":250,
			"height":157
		},
		{
			"id":"c82a81bd5618c6ab",
			"styleAttributes":{},
			"text":"Если изменился файл до добавления в индекс, то нужно снова выполнить git add чтобы обновить информацию в индексе",
			"type":"text",
			"x":2852,
			"y":3549,
			"width":250,
			"height":157
		},
		{
			"id":"8930480ee9feb443",
			"styleAttributes":{},
			"text":"Команда не сохраняет изменения в истории, она подготавливает их для коммита",
			"type":"text",
			"x":2852,
			"y":3403,
			"width":250,
			"height":127
		},
		{
			"id":"a2729836b8992189",
			"styleAttributes":{},
			"text":"С помощью команды git add добавляются нужные файлы в индекс",
			"type":"text",
			"x":2852,
			"y":3103,
			"width":250,
			"height":96
		},
		{
			"id":"32f15d1a363f8165",
			"styleAttributes":{},
			"text":"Запускает интерактивный режим, в котором можно выбрать, какие изменения в каждом файле добавить в индекс",
			"type":"text",
			"x":3140,
			"y":2778,
			"width":250,
			"height":155
		},
		{
			"id":"a6f50ffb00bcfe40",
			"styleAttributes":{},
			"text":"```git\ngit branch\n```",
			"type":"text",
			"x":3880,
			"y":2883,
			"width":250,
			"height":60
		},
		{
			"id":"73981cdcf9eccc7c",
			"styleAttributes":{},
			"text":"```git\ngit commit -m \"Сообщение коммита\"\n```",
			"type":"text",
			"x":3880,
			"y":2778,
			"width":362,
			"height":57
		},
		{
			"id":"abb8fdbb34afb87e",
			"styleAttributes":{},
			"text":"Создание, просмотр и удаление веток",
			"type":"text",
			"x":4309,
			"y":2883,
			"width":250,
			"height":60
		},
		{
			"id":"873faaaf4f0b3bb0",
			"styleAttributes":{},
			"text":"```\ngit log\n```",
			"type":"text",
			"x":3880,
			"y":3422,
			"width":250,
			"height":60
		},
		{
			"id":"5b10a2704ceeac26",
			"styleAttributes":{},
			"text":"```git\ngit checkout\n```",
			"type":"text",
			"x":3880,
			"y":2963,
			"width":250,
			"height":60
		},
		{
			"id":"214e4a3495f4a6e1",
			"styleAttributes":{},
			"text":"Файл anotherfile.txt был изменен",
			"type":"text",
			"x":1798,
			"y":3679,
			"width":250,
			"height":60
		},
		{
			"id":"a9e1833ac1e30ff4",
			"styleAttributes":{},
			"text":"Присутствуют не отслеживаемые файлы",
			"type":"text",
			"x":1798,
			"y":3754,
			"width":250,
			"height":60
		},
		{
			"id":"6826d6c70c09a891",
			"styleAttributes":{},
			"text":"Файл newfile.txt не отслеживается Git'ом",
			"type":"text",
			"x":1798,
			"y":3834,
			"width":250,
			"height":60
		},
		{
			"id":"c6628040f8582a91",
			"styleAttributes":{},
			"text":"Нет изменений, добавленных в индекс",
			"type":"text",
			"x":1798,
			"y":3914,
			"width":250,
			"height":60
		},
		{
			"id":"ebe7f06c5b23c104",
			"styleAttributes":{},
